{%- comment -%}
  Layout container for other blocks: vertical or horizontal, with optional
  color scheme, padding, border, shadow, and a whole-group link.
{%- endcomment -%}
{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
-%}
<{{ tag }}
  {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
  class="tb-group tb-group--{{ block.settings.direction }}{% if block.settings.stack_mobile %} tb-group--stack{% endif %}{% if block.settings.use_scheme %} color-{{ block.settings.color_scheme }} tb-group--surface{% endif %}{% if block.settings.border %} tb-group--border{% endif %}{% if block.settings.shadow %} tb-group--shadow{% endif %} tb-radius-{{ block.settings.corner }}"
  style="--gap: {{ block.settings.gap }}px; --pad: {{ block.settings.padding }}px; --align: {{ block.settings.align }}; --justify: {{ block.settings.justify }};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</{{ tag }}>

{% schema %}
{
  "name": "t:names.group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:labels.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "t:labels.stack_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.start"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.end"
        },
        {
          "value": "stretch",
          "label": "t:options.stretch"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "justify",
      "label": "t:labels.distribution",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.start"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.end"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "t:labels.gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "use_scheme",
      "label": "t:labels.use_its_own_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "paper",
      "visible_if": "{{ block.settings.use_scheme }}"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:labels.padding",
      "default": 0
    },
    {
      "type": "select",
      "id": "corner",
      "label": "t:labels.corners",
      "options": [
        {
          "value": "none",
          "label": "t:options.square"
        },
        {
          "value": "md",
          "label": "t:options.rounded"
        },
        {
          "value": "xl",
          "label": "t:options.extra_rounded"
        }
      ],
      "default": "xl"
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "t:labels.show_border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "t:labels.show_shadow",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:info.makes_the_whole_group_a_link_avoid_buttons_or_li_c1eb50"
    }
  ],
  "presets": [
    {
      "name": "t:names.group",
      "blocks": {
        "heading": {
          "type": "heading"
        },
        "text": {
          "type": "text"
        },
        "button": {
          "type": "button"
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ]
    },
    {
      "name": "t:names.card",
      "settings": {
        "use_scheme": true,
        "padding": 32,
        "shadow": true
      },
      "blocks": {
        "image": {
          "type": "image",
          "settings": {
            "shape": "none",
            "ratio": "3 / 2"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A card title",
            "size": "h4",
            "tag": "h3"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "style": "muted"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "style": "outline",
            "size": "small",
            "label": "Learn more"
          }
        }
      },
      "block_order": [
        "image",
        "heading",
        "text",
        "button"
      ]
    },
    {
      "name": "t:names.icon_row",
      "settings": {
        "direction": "row",
        "justify": "space-between",
        "gap": 24
      },
      "blocks": {
        "one": {
          "type": "icon",
          "settings": {
            "icon": "truck",
            "label": "Free shipping over $100"
          }
        },
        "two": {
          "type": "icon",
          "settings": {
            "icon": "return",
            "label": "30-day returns"
          }
        },
        "three": {
          "type": "icon",
          "settings": {
            "icon": "shield",
            "label": "Secure checkout"
          }
        }
      },
      "block_order": [
        "one",
        "two",
        "three"
      ]
    }
  ]
}
{% endschema %}
