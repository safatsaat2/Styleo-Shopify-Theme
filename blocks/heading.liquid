{%- comment -%} Heading in the theme's serif. Italic words take the accent color. {%- endcomment -%}
{%- if block.settings.heading != blank -%}
  <{{ block.settings.tag }} class="tb-heading {{ block.settings.size }} tb-align-{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
    {{- block.settings.heading -}}
  </{{ block.settings.tag }}>
{%- endif -%}

{% schema %}
{
  "name": "t:names.heading",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Style with <em>intention</em>"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.size",
      "options": [
        {
          "value": "h1",
          "label": "t:options.extra_large"
        },
        {
          "value": "h2",
          "label": "t:options.large"
        },
        {
          "value": "h3",
          "label": "t:options.medium"
        },
        {
          "value": "h4",
          "label": "t:options.small"
        },
        {
          "value": "h5",
          "label": "t:options.extra_small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "t:labels.html_tag",
      "info": "t:info.use_one_h1_per_page_the_tag_sets_the_outline_for_a24356",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "p",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    }
  ],
  "presets": [
    {
      "name": "t:names.heading"
    }
  ]
}
{% endschema %}
