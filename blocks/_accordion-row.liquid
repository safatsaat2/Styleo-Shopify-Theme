<details class="accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
  <summary class="accordion__summary">
    <span>{{ block.settings.heading }}</span>
    {% render 'icon', name: 'chevron-down' %}
  </summary>
  <div class="accordion__content rte">
    {%- if block.settings.page != blank -%}
      {{ block.settings.page.content }}
    {%- else -%}
      {{ block.settings.content }}
    {%- endif -%}
  </div>
</details>

{% schema %}
{
  "name": "t:names.row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Row heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.content",
      "default": "<p>Add details customers often ask about.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:labels.page_content",
      "info": "t:info.replaces_the_content_above"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:labels.open_by_default",
      "default": false
    }
  ]
}
{% endschema %}
