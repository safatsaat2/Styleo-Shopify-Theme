<div class="tb-icon tb-icon--{{ block.settings.layout }} tb-align-{{ block.settings.alignment }}" style="--icon-size: {{ block.settings.size }}px;" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'tb-icon__image', alt: '', widths: '40, 80, 160', sizes: '80px' }}
  {%- elsif block.settings.icon != 'none' -%}
    <span class="tb-icon__glyph">{% render 'icon', name: block.settings.icon %}</span>
  {%- endif -%}
  {%- if block.settings.label != blank -%}
    <span class="tb-icon__label">{{ block.settings.label }}</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "truck",
          "label": "t:options.truck"
        },
        {
          "value": "return",
          "label": "t:options.return"
        },
        {
          "value": "shield",
          "label": "t:options.shield"
        },
        {
          "value": "headset",
          "label": "t:options.headset"
        },
        {
          "value": "gift",
          "label": "t:options.gift"
        },
        {
          "value": "tag",
          "label": "t:options.tag"
        },
        {
          "value": "star",
          "label": "t:options.star"
        },
        {
          "value": "check",
          "label": "t:options.check"
        },
        {
          "value": "heart",
          "label": "t:options.heart"
        },
        {
          "value": "info",
          "label": "t:options.info"
        },
        {
          "value": "location",
          "label": "t:options.location"
        },
        {
          "value": "mail",
          "label": "t:options.mail"
        },
        {
          "value": "account",
          "label": "t:options.account"
        },
        {
          "value": "globe",
          "label": "t:options.globe"
        },
        {
          "value": "calendar",
          "label": "t:options.calendar"
        },
        {
          "value": "phone",
          "label": "t:options.phone"
        },
        {
          "value": "package",
          "label": "t:options.package"
        }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.custom_icon",
      "info": "t:info.replaces_the_icon_use_a_square_image"
    },
    {
      "type": "inline_richtext",
      "id": "label",
      "label": "t:labels.label",
      "default": "Free shipping over $100"
    },
    {
      "type": "range",
      "id": "size",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "t:labels.icon_size",
      "default": 24
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "inline",
          "label": "t:options.icon_beside_label"
        },
        {
          "value": "stacked",
          "label": "t:options.icon_above_label"
        }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    }
  ],
  "presets": [
    {
      "name": "t:names.icon"
    }
  ]
}
{% endschema %}
