<div class="tb-divider tb-divider--{{ block.settings.style }} tb-align-{{ block.settings.alignment }}" style="--width: {{ block.settings.width }}%;" {{ block.shopify_attributes }}>
  {%- if block.settings.style == 'ornament' -%}
    <span class="tb-divider__line"></span>
    <svg class="tb-divider__mark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M12 3l2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z" fill="currentColor"/></svg>
    <span class="tb-divider__line"></span>
  {%- else -%}
    <hr class="tb-divider__line">
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.divider",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        {
          "value": "line",
          "label": "t:options.line"
        },
        {
          "value": "ornament",
          "label": "t:options.line_with_ornament"
        }
      ],
      "default": "line"
    },
    {
      "type": "range",
      "id": "width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:labels.width",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:names.divider"
    }
  ]
}
{% endschema %}
