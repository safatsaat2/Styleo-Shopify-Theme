          "label": "t:options.gift"
        },
        {
          "value": "star",
          "label": "t:options.star"
        },
        {
          "value": "info",
          "label": "t:options.info"
        },
        {
          "value": "truck",
          "label": "t:options.truck"
        },
        {
          "value": "heart",
          "label": "t:options.heart"
        },
        {
          "value": "account",
          "label": "t:options.account"
