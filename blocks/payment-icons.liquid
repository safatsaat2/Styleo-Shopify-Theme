<div class="tb-payment tb-align-{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
  {% render 'payment-icons' %}
</div>

{% schema %}
{
  "name": "t:names.payment_icons",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.shows_the_payment_methods_turned_on_in_your_stor_29633c"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    }
  ],
  "presets": [
    {
      "name": "t:names.payment_icons"
    }
  ]
}
{% endschema %}
