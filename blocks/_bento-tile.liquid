{%- comment -%}
  One tile of the bento grid: a background image or color scheme, its own
  span on the grid, and any blocks inside.
{%- endcomment -%}
{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
-%}
<{{ tag }}
  {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
  class="bento__tile color-{{ block.settings.color_scheme }} bento__tile--{{ block.settings.position }}{% if block.settings.image %} bento__tile--media{% endif %}"
  style="--col: {{ block.settings.columns }}; --row: {{ block.settings.rows }}; --overlay: {{ block.settings.overlay | divided_by: 100.0 }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image -%}
    {% render 'image', image: block.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', class: 'bento__image' %}
    <span class="bento__overlay" aria-hidden="true"></span>
  {%- endif -%}
  <div class="bento__content">
    {% content_for 'blocks' %}
  </div>
</{{ tag }}>

{% schema %}
{
  "name": "t:names.tile",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns_to_span",
      "default": 1
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "t:labels.rows_to_span",
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "paper"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.image_overlay",
      "default": 30,
      "visible_if": "{{ block.settings.image != blank }}"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:info.makes_the_whole_tile_a_link_avoid_buttons_inside_7c916d"
    }
  ]
}
{% endschema %}
