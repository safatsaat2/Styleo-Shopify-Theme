{%- liquid
  assign url = block.settings.link | default: routes.all_products_collection_url
  assign classes = 'button'
  if block.settings.style != 'primary'
    assign classes = classes | append: ' button--' | append: block.settings.style
  endif
  if block.settings.size != ''
    assign classes = classes | append: ' button--' | append: block.settings.size
  endif
  if block.settings.full_width
    assign classes = classes | append: ' button--full'
  endif
-%}
{%- if block.settings.label != blank -%}
  <a
    href="{{ url }}"
    class="{{ classes }} tb-button"
    {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
    {{ block.shopify_attributes }}
  >
    <span>{{ block.settings.label | escape }}</span>
    {%- if block.settings.arrow -%}{% render 'icon', name: 'arrow-right' %}{%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "t:labels.open_link_in_a_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.primary"
        },
        {
          "value": "secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "outline",
          "label": "t:options.outline"
        },
        {
          "value": "surface",
          "label": "t:options.surface"
        }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "arrow",
      "label": "t:labels.show_arrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.button"
    }
  ]
}
{% endschema %}
