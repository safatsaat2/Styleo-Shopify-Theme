<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% render 'meta-tags' %}
    {% render 'head-assets' %}
    {{ 'section-password.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body
    class="color-{{ settings.body_color_scheme.id }} template-password"
    data-button-hover="{{ settings.button_hover }}"
    data-secondary-button="{{ settings.secondary_button_style }}"
  >
    <a class="skip-link button" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    <main id="MainContent" class="main main--password" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div id="LilacLiveRegion" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
