{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "show_title": true,
        "alignment": "start",
        "width": "medium",
        "color_scheme": "cream",
        "padding_top": 48,
        "padding_bottom": 32,
        "subheading": "Orders"
      }
    },
    "steps": {
      "type": "multicolumn",
      "blocks": {
        "email": {
          "type": "column",
          "settings": {
            "icon": "mail",
            "heading": "Check your email",
            "text": "<p>Your shipping confirmation includes a tracking link from the carrier.</p>"
          }
        },
        "account": {
          "type": "column",
          "settings": {
            "icon": "account",
            "heading": "Sign in to your account",
            "text": "<p>See every order, its status, and tracking details in your account.</p>"
          }
        },
        "carrier": {
          "type": "column",
          "settings": {
            "icon": "truck",
            "heading": "Track with the carrier",
            "text": "<p>Use the tracking number on the carrier website for live updates.</p>"
          }
        }
      },
      "block_order": [
        "email",
        "account",
        "carrier"
      ],
      "settings": {
        "heading": "Find your order",
        "alignment": "center",
        "columns": 3,
        "mobile_columns": "1",
        "card_style": "card",
        "color_scheme": "mist",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "help": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "View your orders",
            "size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Signed-in customers can see order status and tracking in their account.</p>"
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "label": "Go to my account",
            "link": "/account",
            "style": "primary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "buttons"
      ],
      "settings": {
        "alignment": "center",
        "width": "narrow",
        "color_scheme": "cream",
        "padding_top": 56,
        "padding_bottom": 32
      }
    },
    "form": {
      "type": "contact-form",
      "blocks": {
        "order": {
          "type": "text_field",
          "settings": {
            "label": "Order number",
            "input_type": "text",
            "width": "half",
            "required": true
          }
        },
        "message": {
          "type": "message",
          "settings": {
            "label": "How can we help?",
            "required": true
          }
        }
      },
      "block_order": [
        "order",
        "message"
      ],
      "settings": {
        "color_scheme": "cream",
        "padding_top": 16,
        "padding_bottom": 80,
        "heading": "Need help with an order?",
        "form_name": "Order question",
        "button_label": "Send"
      }
    }
  },
  "order": [
    "main",
    "steps",
    "help",
    "form"
  ]
}
