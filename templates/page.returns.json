{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "show_title": true,
        "alignment": "start",
        "width": "medium",
        "color_scheme": "cream",
        "padding_top": 48,
        "padding_bottom": 32,
        "subheading": "Returns"
      }
    },
    "steps": {
      "type": "multicolumn",
      "blocks": {
        "request": {
          "type": "column",
          "settings": {
            "icon": "mail",
            "heading": "Request a return",
            "text": "<p>Send the form below or start a return from your account.</p>"
          }
        },
        "pack": {
          "type": "column",
          "settings": {
            "icon": "gift",
            "heading": "Pack your items",
            "text": "<p>Include all tags and the original packaging.</p>"
          }
        },
        "refund": {
          "type": "column",
          "settings": {
            "icon": "return",
            "heading": "Get your refund",
            "text": "<p>We refund to the original payment method after inspection.</p>"
          }
        }
      },
      "block_order": [
        "request",
        "pack",
        "refund"
      ],
      "settings": {
        "heading": "How returns work",
        "alignment": "center",
        "columns": 3,
        "mobile_columns": "1",
        "card_style": "card",
        "color_scheme": "mist",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "form": {
      "type": "contact-form",
      "blocks": {
        "order": {
          "type": "text_field",
          "settings": {
            "label": "Order number",
            "input_type": "text",
            "width": "half",
            "required": true
          }
        },
        "reason": {
          "type": "select",
          "settings": {
            "label": "Reason",
            "options": "Too small, Too large, Not as expected, Arrived damaged, Other",
            "width": "half",
            "required": true
          }
        },
        "items": {
          "type": "textarea",
          "settings": {
            "label": "Items to return",
            "required": true
          }
        },
        "message": {
          "type": "message",
          "settings": {
            "label": "Anything else we should know",
            "required": false
          }
        }
      },
      "block_order": [
        "order",
        "reason",
        "items",
        "message"
      ],
      "settings": {
        "color_scheme": "cream",
        "padding_top": 16,
        "padding_bottom": 80,
        "heading": "Start a return",
        "form_name": "Return request",
        "button_label": "Request return"
      }
    }
  },
  "order": [
    "main",
    "steps",
    "form"
  ]
}
