{%- liquid
  assign slide_count = section.blocks.size
  if section.index <= 2
    assign first_loading = 'eager'
    assign first_priority = 'high'
  else
    assign first_loading = 'lazy'
    assign first_priority = 'auto'
  endif
  assign autoplay_ms = 0
  if section.settings.autoplay and slide_count > 1
    assign autoplay_ms = section.settings.autoplay_speed | times: 1000
  endif
-%}

<div class="slideshow-section color-{{ section.settings.color_scheme }} visibility-{{ section.settings.visibility }}">
  <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width slideshow--inset{% endif %} section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <lc-slideshow
      class="slideshow slideshow--{{ section.settings.height }}"
      data-autoplay="{{ autoplay_ms }}"
      role="region"
      aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
      aria-label="{{ section.settings.accessibility_label | escape }}"
      style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    >
      <div class="slideshow__track scroller" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_loading = 'lazy'
            assign slide_priority = 'auto'
            if forloop.first
              assign slide_loading = first_loading
              assign slide_priority = first_priority
            endif
          -%}
          <div
            class="slideshow__slide{% if forloop.first %} is-active{% endif %}"
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ 'sections.slideshow.slide_of' | t: index: forloop.index, count: slide_count }}"
            {{ block.shopify_attributes }}
          >
            <div class="slideshow__media media">
              {%- if block.settings.image != blank -%}
                {%- if block.settings.image_mobile != blank -%}
                  <picture>
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                      sizes="100vw"
                    >
                    {% render 'image', image: block.settings.image, sizes: '100vw', loading: slide_loading, fetchpriority: slide_priority %}
                  </picture>
                {%- else -%}
                  {% render 'image', image: block.settings.image, sizes: '100vw', loading: slide_loading, fetchpriority: slide_priority %}
                {%- endif -%}
              {%- else -%}
                {%- capture placeholder_name -%}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="slideshow__content slideshow__content--{{ block.settings.horizontal }} slideshow__content--{{ block.settings.vertical }} page-width">
              <div class="slideshow__text color-{{ block.settings.color_scheme }}">
                {%- if block.settings.subheading != blank -%}
                  <p class="subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  {%- if section.index == 1 and forloop.first -%}
                    <h1 class="h0 text-balance">{{ block.settings.heading }}</h1>
                  {%- else -%}
                    <h2 class="h1 text-balance">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-lg">{{ block.settings.text }}</div>
                {%- endif -%}
                {% render 'button',
                  label: block.settings.button_label,
                  url: block.settings.button_link,
                  style: block.settings.button_style,
                  arrow: true,
                  size: 'large'
                %}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 -%}
        <div class="slideshow__controls">
          {%- if section.settings.show_arrows -%}
            <button type="button" class="slideshow__arrow icon-button" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
              {% render 'icon', name: 'chevron-left' %}
            </button>
          {%- endif -%}
          <ul class="carousel__dots slideshow__dots" data-carousel-dots data-label="{{ 'sections.slideshow.go_to' | t }}"></ul>
          {%- if section.settings.show_arrows -%}
            <button type="button" class="slideshow__arrow icon-button" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
              {% render 'icon', name: 'chevron-right' %}
            </button>
          {%- endif -%}
          {%- if autoplay_ms > 0 -%}
            <button
              type="button"
              class="slideshow__arrow icon-button"
              data-slideshow-pause
              aria-label="{{ 'accessibility.pause' | t }}"
              data-label-pause="{{ 'accessibility.pause' | t }}"
              data-label-play="{{ 'accessibility.play' | t }}"
            >
              <span data-icon-pause>{% render 'icon', name: 'pause' %}</span>
              <span data-icon-play hidden>{% render 'icon', name: 'play' %}</span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </lc-slideshow>
  </div>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.slideshow",
  "tag": "section",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full",
          "label": "t:options.full_screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.make_section_full_width",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.image_overlay_opacity",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:labels.show_arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.change_slides_automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:labels.change_every",
      "default": 6
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:labels.slideshow_description",
      "info": "t:info.read_by_screen_readers",
      "default": "Featured looks"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "noir"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "t:labels.show_on",
      "options": [
        {
          "value": "all",
          "label": "t:options.all_devices"
        },
        {
          "value": "mobile",
          "label": "t:options.small_screens_only"
        },
        {
          "value": "desktop",
          "label": "t:options.large_screens_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:names.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.n_2400_x_1200px_jpg_recommended"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:labels.mobile_image",
          "info": "t:info.optional_1100_x_1400px_jpg_recommended"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:labels.subheading",
          "default": "New season"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Introduce a collection"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Pair large imagery with a short message about what's new.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:labels.button_link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:labels.button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:options.primary"
            },
            {
              "value": "secondary",
              "label": "t:options.secondary"
            },
            {
              "value": "surface",
              "label": "t:options.white"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "horizontal",
          "label": "t:labels.horizontal_text_position",
          "options": [
            {
              "value": "start",
              "label": "t:options.left"
            },
            {
              "value": "center",
              "label": "t:options.center"
            },
            {
              "value": "end",
              "label": "t:options.right"
            }
          ],
          "default": "start"
        },
        {
          "type": "select",
          "id": "vertical",
          "label": "t:labels.vertical_text_position",
          "options": [
            {
              "value": "top",
              "label": "t:options.top"
            },
            {
              "value": "middle",
              "label": "t:options.middle"
            },
            {
              "value": "bottom",
              "label": "t:options.bottom"
            }
          ],
          "default": "middle"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:labels.text_color_scheme",
          "info": "t:info.only_the_text_and_button_colors_are_used",
          "default": "noir"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
