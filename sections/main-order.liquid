{%- comment -%}
  Legacy customer accounts: one order with line items, tracking, totals,
  and addresses. App blocks render under the order.
{%- endcomment -%}

<div class="customer customer--order color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--medium section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <a href="{{ routes.account_url }}" class="link customer__back">
      {% render 'icon', name: 'arrow-left' %}
      {{ 'customer.order.back' | t }}
    </a>

    <header class="customer__header">
      <div>
        <p class="subheading">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
        <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
      </div>
      <div class="button-row">
        {%- comment -%} Buy again: adds every line that's still available back to the cart {%- endcomment -%}
        {%- liquid
          assign reorder_count = 0
          for line_item in order.line_items
            if line_item.variant.available
              assign reorder_count = reorder_count | plus: 1
            endif
          endfor
        -%}
        {%- if reorder_count > 0 -%}
          <form method="post" action="{{ routes.cart_add_url }}">
            {%- for line_item in order.line_items -%}
              {%- if line_item.variant.available -%}
                <input type="hidden" name="items[][id]" value="{{ line_item.variant.id }}">
                <input type="hidden" name="items[][quantity]" value="{{ line_item.quantity }}">
              {%- endif -%}
            {%- endfor -%}
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <button type="submit" class="button button--small">
              {% render 'icon', name: 'bag' %}
              {{ 'customer.order.buy_again' | t }}
            </button>
          </form>
        {%- endif -%}
        {%- if order.order_status_url != blank -%}
          <a href="{{ order.order_status_url }}" class="button button--outline button--small">
            {% render 'icon', name: 'truck' %}
            {{ 'customer.order.status_page' | t }}
          </a>
        {%- endif -%}
      </div>
    </header>

    {%- if order.cancelled -%}
      <div class="form-message form-message--error customer__notice" role="status">
        {% render 'icon', name: 'info' %}
        <span>
          {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date_at_time' -%}
          {{ 'customer.order.cancelled' | t: date: cancelled_at }}
          {{ 'customer.order.cancel_reason' | t: reason: order.cancel_reason_label }}
        </span>
      </div>
    {%- endif -%}

    <div class="customer__layout">
      <div class="customer__main">
        <ul class="order__items" role="list">
          {%- for line_item in order.line_items -%}
            <li class="order__item">
              <div class="order__media">
                {%- if line_item.image -%}
                  {{ line_item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '80, 120, 160, 240', sizes: '80px', alt: line_item.image.alt }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="order__details">
                {%- if line_item.url != blank -%}
                  <a href="{{ line_item.url }}" class="order__title link">{{ line_item.product.title | default: line_item.title }}</a>
                {%- else -%}
                  <p class="order__title">{{ line_item.title }}</p>
                {%- endif -%}
                {%- unless line_item.product.has_only_default_variant or line_item.variant_title == blank -%}
                  <p class="order__meta">{{ line_item.variant_title }}</p>
                {%- endunless -%}
                {%- if line_item.selling_plan_allocation -%}
                  <p class="order__meta">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}
                {%- for property in line_item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}
                    <p class="order__meta">{{ property.first }}: {{ property.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
                {%- if line_item.sku != blank -%}
                  <p class="order__meta">{{ 'customer.order.sku' | t: sku: line_item.sku }}</p>
                {%- endif -%}
                {%- for allocation in line_item.line_level_discount_allocations -%}
                  <p class="order__discount">
                    {% render 'icon', name: 'tag' %}
                    {%- assign allocation_amount = allocation.amount | money -%}
                    {{ allocation.discount_application.title }} (-{{ allocation_amount }})
                  </p>
                {%- endfor -%}

                {%- if line_item.fulfillment -%}
                  <div class="order__fulfillment">
                    {%- assign fulfilled_on = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                    <p>{% render 'icon', name: 'truck' %} {{ 'customer.order.fulfilled' | t: date: fulfilled_on }}</p>
                    {%- if line_item.fulfillment.tracking_number -%}
                      <p>
                        {{ line_item.fulfillment.tracking_company }}
                        {%- if line_item.fulfillment.tracking_url -%}
                          <a href="{{ line_item.fulfillment.tracking_url }}" class="link" target="_blank" rel="noopener">{{ 'customer.order.track' | t: number: line_item.fulfillment.tracking_number }}</a>
                        {%- else -%}
                          {{ line_item.fulfillment.tracking_number }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  </div>
                {%- elsif line_item.fulfillment_service != 'manual' and line_item.requires_shipping == false -%}
                  <p class="order__meta">{{ 'customer.order.digital' | t }}</p>
                {%- endif -%}
              </div>
              <div class="order__numbers">
                <p class="order__qty">{{ 'customer.order.quantity' | t: quantity: line_item.quantity }}</p>
                {%- if line_item.original_line_price != line_item.final_line_price -%}
                  <s class="text-muted">{{ line_item.original_line_price | money }}</s>
                {%- endif -%}
                <p class="order__line-price">{{ line_item.final_line_price | money }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <dl class="order__totals">
          <div>
            <dt>{{ 'customer.order.subtotal' | t }}</dt>
            <dd>{{ order.line_items_subtotal_price | money }}</dd>
          </div>
          {%- for discount_application in order.cart_level_discount_applications -%}
            <div class="order__totals-discount">
              <dt>{% render 'icon', name: 'tag' %} {{ discount_application.title }}</dt>
              <dd>-{{ discount_application.total_allocated_amount | money }}</dd>
            </div>
          {%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}
            <div>
              <dt>{{ 'customer.order.shipping' | t: method: shipping_method.title }}</dt>
              <dd>{{ shipping_method.price | money }}</dd>
            </div>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <div>
              <dt>{{ 'customer.order.tax' | t: title: tax_line.title, rate: tax_line.rate_percentage }}</dt>
              <dd>{{ tax_line.price | money }}</dd>
            </div>
          {%- endfor -%}
          {%- if order.total_duties -%}
            <div>
              <dt>{{ 'customer.order.duties' | t }}</dt>
              <dd>{{ order.total_duties | money }}</dd>
            </div>
          {%- endif -%}
          <div class="order__grand-total">
            <dt>{{ 'customer.order.total' | t }}</dt>
            <dd>{{ order.total_net_amount | money_with_currency }}</dd>
          </div>
          {%- if order.total_refunded_amount > 0 -%}
            <div>
              <dt>{{ 'customer.order.refunded' | t }}</dt>
              <dd>-{{ order.total_refunded_amount | money }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>

      <aside class="customer__aside">
        <div class="customer__box panel">
          <h2 class="h5">{{ 'customer.order.status' | t }}</h2>
          <p>{{ 'customer.order.payment_status' | t: status: order.financial_status_label }}</p>
          {%- unless order.cancelled -%}
            <p>{{ 'customer.order.fulfillment_status' | t: status: order.fulfillment_status_label }}</p>
          {%- endunless -%}
        </div>
        {%- if order.shipping_address -%}
          <div class="customer__box panel">
            <h2 class="h5">{{ 'customer.order.shipping_address' | t }}</h2>
            <address class="customer__address">{{ order.shipping_address | format_address }}</address>
          </div>
        {%- endif -%}
        {%- if order.billing_address -%}
          <div class="customer__box panel">
            <h2 class="h5">{{ 'customer.order.billing_address' | t }}</h2>
            <address class="customer__address">{{ order.billing_address | format_address }}</address>
          </div>
        {%- endif -%}
      </aside>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="customer__apps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'custom_liquid' -%}
            <div class="customer__custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- else -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.customer_order",
  "tag": "section",
  "class": "section-customer-order",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:names.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:labels.liquid_code",
          "info": "t:info.add_app_snippets_or_other_code_code_here_is_your_e2a3d2"
        }
      ]
    }
  ]
}
{% endschema %}
