{%- comment -%}
  Related products from the Product Recommendations API. Loads after the
  page renders; shows nothing when there are no recommendations.
{%- endcomment -%}

<div class="product-recommendations-section color-{{ section.settings.color_scheme }}">
  <lc-recommendations
    class="page-width section-spacing"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
    data-target="[data-recommendations-content]"
  >
    <div data-recommendations-content>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {% render 'section-heading', heading: section.settings.heading, subheading: section.settings.subheading %}
        <lc-carousel class="product-list product-list--desktop-{{ section.settings.desktop_layout }} product-list--mobile-carousel" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
          <ul class="product-list__track" role="list" data-carousel-track>
            {%- for recommendation in recommendations.products -%}
              {%- comment -%} Never recommend the gift wrap product {%- endcomment -%}
              {%- if recommendation.id == settings.gift_wrap_product.id or recommendation.tags contains 'gift-wrap' -%}{%- continue -%}{%- endif -%}
              <li class="product-list__item">
                {% render 'product-card', product: recommendation, index: forloop.index0, section_id: section.id %}
              </li>
            {%- endfor -%}
          </ul>
          <button type="button" class="carousel__button carousel__button--prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <button type="button" class="carousel__button carousel__button--next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </lc-carousel>
      {%- endif -%}
    </div>
  </lc-recommendations>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer></script>
<script src="{{ 'recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.product_recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.recommendations_update_automatically_from_order_a2ada5"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.products_to_show",
      "options": [
        {
          "value": "related",
          "label": "t:options.related_products"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary_products"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "t:labels.number_of_products",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.products_per_row_on_large_screens",
      "default": 4
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:labels.layout_on_large_screens",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations"
    }
  ]
}
{% endschema %}
