{%- comment -%}
  Product suggestions for the cart, from the Product Recommendations API
  using the first cart item. Products already in the cart are skipped.
  Used on the cart page (as a section) and in the cart drawer, which
  renders this file by its section id.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'cart.upsell.heading' | t
  endif
  assign cart_product_ids = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
  assign first_item = cart.items | where: 'requires_shipping', true | first | default: cart.items.first
-%}

<div class="cart-upsell-section color-{{ section.settings.color_scheme }}">
  {%- if recommendations.performed -%}
    <div data-cart-upsell-content>
      {%- assign shown = 0 -%}
      {%- capture upsell_items -%}
        {%- for product in recommendations.products -%}
          {%- assign product_id_string = product.id | prepend: ',' | append: ',' -%}
          {%- if cart_product_ids contains product_id_string or product.available == false -%}{%- continue -%}{%- endif -%}
          {%- if product.id == settings.gift_wrap_product.id or product.tags contains 'gift-wrap' -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="cart-upsell__item">
            {% render 'product-card', product: product, style: section.settings.card_style, style_mobile: 'row', sizes: '200px', section_id: 'cart-upsell', heading_tag: 'p' %}
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if shown > 0 -%}
        <p class="cart-upsell__heading h5">{{ heading }}</p>
        <ul class="cart-upsell__list cart-upsell__list--{{ section.settings.card_style }}" role="list">{{ upsell_items }}</ul>
      {%- endif -%}
    </div>
  {%- elsif cart.item_count > 0 -%}
    <lc-recommendations
      class="cart-upsell page-width section-spacing"
      style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ first_item.product_id }}&limit=10&intent=related"
      data-target="[data-cart-upsell-content]"
    >
      <div data-cart-upsell-content></div>
    </lc-recommendations>
  {%- endif -%}
</div>

<script src="{{ 'recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.cart_suggestions",
  "tag": "section",
  "class": "section-cart-upsell",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.suggestions_are_based_on_the_first_item_in_the_c_02c413"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:labels.number_of_products",
      "default": 4
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:labels.card_style",
      "options": [
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "row",
          "label": "t:options.row"
        },
        {
          "value": "compact",
          "label": "t:options.compact"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.cart_suggestions"
    }
  ]
}
{% endschema %}
