{%- comment -%}
  Recently viewed products. Product pages save product ids in this browser
  only (localStorage, key lilac-recently-viewed). recently-viewed.js asks the
  search page for those ids and renders this section with the results.
  Nothing renders for shoppers with no history.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show
  assign is_lookup = false
  if request.page_type == 'search' and search.terms contains 'id:'
    assign is_lookup = true
  endif
-%}

<lc-recently-viewed
  class="recently-viewed color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-limit="{{ limit }}"
  {% if product %}data-exclude="{{ product.id }}"{% endif %}
  {% unless request.design_mode %}hidden{% endunless %}
>
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {% render 'section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading
    %}

    <ul
      class="grid recently-viewed__grid"
      style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};"
      role="list"
      data-recently-viewed-list
    >
      {%- if is_lookup -%}
        {%- for item in search.results limit: 12 -%}
          {%- if item.object_type == 'product' -%}
            <li class="grid__item" data-product-id="{{ item.id }}">
              {% render 'product-card', product: item, index: forloop.index, section_id: section.id %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..limit) -%}
          <li class="grid__item">{% render 'product-card', index: forloop.index %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_clear -%}
      <div class="recently-viewed__actions">
        <button type="button" class="link recently-viewed__clear" data-recently-viewed-clear>{{ 'recently_viewed.clear' | t }}</button>
      </div>
    {%- endif -%}
  </div>
</lc-recently-viewed>

{{ 'section-customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.recently_viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Still thinking it over"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:labels.columns_on_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.1_column"
        },
        {
          "value": "2",
          "label": "t:options.2_columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_clear",
      "label": "t:labels.show_clear_history_button",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:content.history_is_saved_in_the_shopper_s_browser_only"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.recently_viewed"
    }
  ]
}
{% endschema %}
