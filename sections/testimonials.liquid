{%- comment -%}
  Testimonials written and published by the merchant. For customer reviews
  collected from shoppers, add a reviews app block instead.
{%- endcomment -%}

<div class="testimonials-section color-{{ section.settings.color_scheme }} visibility-{{ section.settings.visibility }}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {% render 'section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      align: 'center'
    %}

    <lc-carousel class="testimonials testimonials--{{ section.settings.layout }}">
      <ul class="testimonials__track" role="list" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'testimonial' -%}
              <li class="testimonials__item" {{ block.shopify_attributes }}>
                <figure class="testimonial">
                  {%- if block.settings.rating > 0 -%}
                    <div class="rating testimonial__rating">
                      <span class="rating__stars" style="--rating: {{ block.settings.rating }};" aria-hidden="true"></span>
                      <span class="visually-hidden">{{ 'products.rating.label' | t: rating: block.settings.rating, max: 5 }}</span>
                    </div>
                  {%- endif -%}
                  <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
                  <figcaption class="testimonial__author">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', class: 'testimonial__avatar', alt: '', widths: '48, 96', sizes: '48px' }}
                    {%- endif -%}
                    <span>
                      <span class="testimonial__name">{{ block.settings.author }}</span>
                      {%- if block.settings.role != blank -%}
                        <span class="testimonial__role">{{ block.settings.role }}</span>
                      {%- endif -%}
                    </span>
                  </figcaption>
                </figure>
              </li>
            {%- when '@app' -%}
              <li class="testimonials__item testimonials__item--app" {{ block.shopify_attributes }}>{% render block %}</li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.layout == 'carousel' -%}
        <button type="button" class="carousel__button carousel__button--prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button type="button" class="carousel__button carousel__button--next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      {%- endif -%}
    </lc-carousel>
  </div>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Kind words"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What customers say"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "grid",
          "label": "t:options.grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "mist"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "t:labels.show_on",
      "options": [
        {
          "value": "all",
          "label": "t:options.all_devices"
        },
        {
          "value": "mobile",
          "label": "t:options.small_screens_only"
        },
        {
          "value": "desktop",
          "label": "t:options.large_screens_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:names.testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:labels.quote",
          "default": "<p>Add a testimonial from a real customer, with their permission.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:labels.name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:labels.detail",
          "info": "t:info.for_example_a_city_or_the_product_they_bought"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.photo"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "t:labels.star_rating",
          "info": "t:info.use_the_rating_the_customer_gave_set_to_0_to_hid_994de6",
          "default": 0
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:names.testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
