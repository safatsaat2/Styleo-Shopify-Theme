{%- comment -%}
  Legacy customer accounts: address book. Add, edit, delete, and set the
  default address. Province options follow the selected country.
{%- endcomment -%}

<div class="customer customer--addresses color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--medium section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <a href="{{ routes.account_url }}" class="link customer__back">
      {% render 'icon', name: 'arrow-left' %}
      {{ 'customer.order.back' | t }}
    </a>

    <header class="customer__header">
      <div>
        <p class="subheading">{{ 'customer.account.subheading' | t }}</p>
        <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
      </div>
    </header>

    {%- comment -%} The new address form opens again when it returns errors {%- endcomment -%}
    {%- capture new_address_form -%}
      {%- form 'customer_address', customer.new_address, class: 'customer__form' -%}
        {% render 'customer-form-errors', form: form %}
        {% render 'address-fields', form: form, prefix: 'New' %}
        <div class="button-row">
          <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
        </div>
      {%- endform -%}
    {%- endcapture -%}
    {%- assign new_has_errors = false -%}
    {%- if new_address_form contains 'form-message--error' -%}
      {%- assign new_has_errors = true -%}
    {%- endif -%}

    <details class="accordion customer__new panel"{% if new_has_errors %} open{% endif %}>
      <summary class="accordion__summary">
        <span>{% render 'icon', name: 'plus' %} {{ 'customer.addresses.add_new' | t }}</span>
        {% render 'icon', name: 'chevron-down' %}
      </summary>
      <div class="accordion__content">{{ new_address_form }}</div>
    </details>

    {%- paginate customer.addresses by 10 -%}
      <ul class="customer__address-list" role="list">
        {%- for address in customer.addresses -%}
          {%- capture edit_form -%}
            {%- form 'customer_address', address, class: 'customer__form' -%}
              {% render 'customer-form-errors', form: form %}
              {%- assign is_default = false -%}
              {%- if address.id == customer.default_address.id -%}{%- assign is_default = true -%}{%- endif -%}
              {% render 'address-fields', form: form, prefix: address.id, is_default: is_default %}
              <div class="button-row">
                <button type="submit" class="button">{{ 'customer.addresses.save' | t }}</button>
              </div>
            {%- endform -%}
          {%- endcapture -%}
          <li class="customer__address-card panel">
            {%- if address.id == customer.default_address.id -%}
              <span class="badge">{{ 'customer.addresses.default' | t }}</span>
            {%- endif -%}
            <address class="customer__address">{{ address | format_address }}</address>
            <div class="customer__address-actions">
              <form method="post" action="{{ address.url }}" data-confirm="{{ 'customer.addresses.delete_confirm' | t | escape }}">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="button button--outline button--small">
                  {% render 'icon', name: 'trash' %}
                  {{ 'customer.addresses.delete' | t }}
                </button>
              </form>
            </div>
            <details class="accordion customer__edit"{% if edit_form contains 'form-message--error' %} open{% endif %}>
              <summary class="accordion__summary">
                <span>{% render 'icon', name: 'edit' %} {{ 'customer.addresses.edit' | t }}</span>
                {% render 'icon', name: 'chevron-down' %}
              </summary>
              <div class="accordion__content">{{ edit_form }}</div>
            </details>
          </li>
        {%- else -%}
          <li class="customer__empty panel">
            {% render 'icon', name: 'location' %}
            <p>{{ 'customer.addresses.none' | t }}</p>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{{ 'section-customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.customer_addresses",
  "tag": "section",
  "class": "section-customer-addresses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ]
}
{% endschema %}
