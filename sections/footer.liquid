{%- liquid
  assign show_localization = false
  if section.settings.show_country and localization.available_countries.size > 1
    assign show_localization = true
  endif
  if section.settings.show_language and localization.available_languages.size > 1
    assign show_localization = true
  endif
-%}

<div class="footer color-{{ section.settings.color_scheme }}">
  {%- if section.blocks.size > 0 -%}
    <div class="footer__main page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type | replace: '@', '' }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.show_logo -%}
                  {% render 'logo', class: 'footer__logo' %}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons', class: 'footer__social' %}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="h5 footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="footer__menu" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="footer__link"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="h5 footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="h4 footer__newsletter-heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {% render 'newsletter-form', id: 'FooterNewsletter', class: 'footer__newsletter' %}

              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}

              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="footer__bottom">
    <div class="footer__bottom-inner page-width">
      <div class="footer__bottom-start">
        {%- if show_localization -%}
          {%- render 'localization-form',
            id: 'FooterLocalization',
            show_country: section.settings.show_country,
            show_language: section.settings.show_language,
            class: 'footer__localization'
          -%}
        {%- endif -%}

        {%- if section.settings.show_follow_on_shop and shop.features.follow_on_shop? -%}
          <div class="footer__follow">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          {% render 'payment-icons' %}
        {%- endif -%}
      </div>

      <div class="footer__bottom-end">
        <p class="footer__copyright">
          <span>&copy; {{ 'now' | date: '%Y' }}, <a href="{{ routes.root_url }}">{{ shop.name }}</a></span>
          {%- if section.settings.copyright_text != blank -%}
            <span>{{ section.settings.copyright_text }}</span>
          {%- endif -%}
          {%- if section.settings.show_powered_by -%}
            <span>{{ powered_by_link }}</span>
          {%- endif -%}
        </p>

        {%- if section.settings.show_policies -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}" class="footer__policy-link">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.footer",
  "tag": "footer",
  "class": "section-footer",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "noir"
    },
    {
      "type": "header",
      "content": "t:content.bottom_bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:labels.show_country_region_selector",
      "info": "t:info.shown_when_you_sell_in_more_than_one_market",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:labels.show_language_selector",
      "info": "t:info.shown_when_your_store_has_more_than_one_publishe_e14430",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.show_follow_on_shop",
      "info": "t:info.customers_can_follow_your_store_in_the_shop_app_739e3a",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:labels.show_policy_links",
      "info": "t:info.add_policies_in_your_store_s_policy_settings",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "copyright_text",
      "label": "t:labels.copyright_text"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:labels.show_shopify_credit",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:names.brand",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "t:labels.show_logo",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Tell customers what your brand stands for in a sentence or two.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "t:labels.show_social_media_icons",
          "info": "t:info.add_your_accounts_in_theme_settings_social_media",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:names.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Share contact details, store hours, or a short message.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:names.email_signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Subscribe to our emails"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Be the first to hear about new arrivals and exclusive offers.</p>"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:names.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:labels.custom_liquid",
          "info": "t:info.add_app_snippets_or_other_liquid_code"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "blocks": [
        {
          "type": "brand"
        },
        {
          "type": "menu"
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
