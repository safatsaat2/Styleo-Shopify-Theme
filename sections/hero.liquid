{%- liquid
  assign image = section.settings.image
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
  if section.index <= 2
    assign media_loading = 'eager'
    assign media_priority = 'high'
  else
    assign media_loading = 'lazy'
    assign media_priority = 'auto'
  endif

  case section.settings.media_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'tall'
      assign ratio = '3 / 4'
    else
      assign ratio = '4 / 5'
  endcase

  assign orbit_blocks = section.blocks | where: 'type', 'orbit_badge'
-%}

{%- capture overlay -%}
  {%- for block in orbit_blocks -%}
    <div {{ block.shopify_attributes }}>
      {% render 'orbit-badge', text: block.settings.text, id: block.id, position: block.settings.position %}
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div
  class="hero hero--{{ section.settings.layout }} hero--media-{{ section.settings.media_position }} hero--height-{{ section.settings.height }} color-{{ section.settings.color_scheme }} visibility-{{ section.settings.visibility }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if section.settings.show_glow -%}
    <span class="glow hero__glow hero__glow--one" aria-hidden="true"></span>
    <span class="glow hero__glow hero__glow--two" aria-hidden="true"></span>
  {%- endif -%}

  {%- if section.settings.layout == 'overlay' -%}
    <div class="hero__backdrop media">
      {%- if image != blank -%}
        {% render 'image', image: image, sizes: '100vw', loading: media_loading, fetchpriority: media_priority %}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hero__inner page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="hero__content hero__content--{{ section.settings.alignment }} hero__content--mobile-{{ section.settings.mobile_alignment }} animate-fade-up">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <p class="subheading hero__subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

          {%- when 'heading' -%}
            {%- liquid
              assign heading_tag = 'h2'
              if is_first
                assign heading_tag = 'h1'
              endif
            -%}
            <{{ heading_tag }} class="hero__heading {{ block.settings.size }} text-balance" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
              {%- if block.settings.accent_line != blank -%}
                <span class="hero__accent">{{ block.settings.accent_line }}</span>
              {%- endif -%}
            </{{ heading_tag }}>

          {%- when 'text' -%}
            <div class="hero__text rte text-lg" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </div>

          {%- when 'buttons' -%}
            <div class="button-row hero__buttons" {{ block.shopify_attributes }}>
              {% render 'button',
                label: block.settings.button_label,
                url: block.settings.button_link,
                style: block.settings.button_style,
                arrow: block.settings.show_arrow,
                size: 'large'
              %}
              {% render 'button',
                label: block.settings.button_label_2,
                url: block.settings.button_link_2,
                style: block.settings.button_style_2,
                size: 'large'
              %}
            </div>

          {%- when 'countdown' -%}
            <div class="hero__countdown" data-countdown-wrapper {{ block.shopify_attributes }}>
              {% render 'countdown',
                end_date: block.settings.end_date,
                end_time: block.settings.end_time,
                label: block.settings.label
              %}
            </div>

          {%- when 'custom_liquid' -%}
            <div class="hero__liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.layout == 'split' -%}
      <div class="hero__media animate-fade-in">
        {% render 'media-halo',
          image: image,
          shape: section.settings.halo_shape,
          ratio: ratio,
          sizes: '(min-width: 1280px) 600px, (min-width: 750px) 50vw, 90vw',
          loading: media_loading,
          fetchpriority: media_priority,
          placeholder: 'lifestyle-2',
          overlay: overlay
        %}
      </div>
    {%- elsif overlay != blank -%}
      <div class="hero__overlay-badges">{{ overlay }}</div>
    {%- endif -%}
  </div>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}
{%- assign countdown_blocks = section.blocks | where: 'type', 'countdown' -%}
{%- if countdown_blocks.size > 0 -%}
  <script src="{{ 'countdown.js' | asset_url }}" defer></script>
{%- endif -%}

