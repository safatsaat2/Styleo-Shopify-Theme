{%- comment -%}
  FAQ: grouped questions in accordions with an optional search field.
  Outputs FAQPage structured data from the same content.
{%- endcomment -%}

<div class="faq-section color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--medium section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {% render 'section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      text: section.settings.text,
      align: 'center'
    %}

    <lc-faq class="faq">
      {%- if section.settings.show_search -%}
        <div class="faq__search inline-field js-only">
          {% render 'icon', name: 'search' %}
          <label for="FaqSearch-{{ section.id }}" class="visually-hidden">{{ 'faq.search_label' | t }}</label>
          <input
            id="FaqSearch-{{ section.id }}"
            class="input"
            type="search"
            placeholder="{{ 'faq.search_placeholder' | t }}"
            autocomplete="off"
            data-faq-search
          >
        </div>
        <p class="faq__status" role="status" aria-live="polite" data-faq-status></p>
      {%- endif -%}

      <div class="faq__groups">
        {%- comment -%} Questions before the first group heading {%- endcomment -%}
        {%- capture leading -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'group' -%}{%- break -%}{%- endif -%}
            {% render 'faq-item', block: block %}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if leading != blank -%}
          <div class="faq__group">{{ leading }}</div>
        {%- endif -%}

        {%- for group in section.blocks -%}
          {%- if group.type != 'group' -%}{%- continue -%}{%- endif -%}
          <div class="faq__group">
            <h3 class="faq__group-title h5" {{ group.shopify_attributes }}>{{ group.settings.heading }}</h3>
            {%- assign start = forloop.index -%}
            {%- for block in section.blocks offset: start -%}
              {%- if block.type == 'group' -%}{%- break -%}{%- endif -%}
              {% render 'faq-item', block: block %}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </lc-faq>
  </div>
</div>

{%- assign questions = section.blocks | where: 'type', 'question' -%}
{%- if questions.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in questions -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'content.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.faq",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Help center"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search_field",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:names.group_heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Orders and shipping"
        }
      ]
    },
    {
      "type": "question",
      "name": "t:names.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Add a question customers often ask"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>Answer clearly and link to a policy page when it helps.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:labels.open_by_default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.faq",
      "blocks": [
        {
          "type": "group"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
