{%- liquid
  assign product = section.settings.product
  assign form_id = 'ProductForm-' | append: section.id
  assign media_layout = 'carousel'
-%}

<div class="featured-product-section color-{{ section.settings.color_scheme }} visibility-{{ section.settings.visibility }}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {%- if product != blank -%}
      <lc-product
        class="product product--featured product--carousel product--featured-{{ section.settings.media_position }}"
        data-section-id="{{ section.id }}"
        data-render-section="quick-view"
        data-product-url="{{ product.url }}"
        data-product-id="{{ product.id }}"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        data-variant-media-id="{{ product.selected_or_first_available_variant.featured_media.id }}"
      >
        <div class="product__grid">
          <div class="product__media">
            {% render 'product-gallery',
              product: product,
              section: section,
              layout: media_layout,
              ratio: section.settings.media_ratio,
              zoom: 'dialog',
              loop_video: true,
              priority: 'auto',
              sizes: '(min-width: 990px) 50vw, 100vw'
            %}
          </div>
          <div class="product__info">
            <div class="product__info-inner">
              {% render 'product-info-blocks', product: product, section: section, form_id: form_id, context: 'featured' %}
              <a href="{{ product.url }}" class="link-arrow product__details-link">
                {{- 'products.view_details' | t -}}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            </div>
          </div>
        </div>
      </lc-product>
    {%- else -%}
      <div class="product product--featured product--placeholder">
        <div class="product__grid">
          <div class="product__media">
            <div class="product-media media" style="--ratio: 3 / 4;">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </div>
          <div class="product__info">
            <div class="product__info-inner">
              <h2 class="product__title h2">{{ 'products.placeholder_title' | t }}</h2>
              <div class="price price--large"><span class="price__current">{{ 4900 | money }}</span></div>
              <p class="text-muted">{{ 'products.placeholder_description' | t }}</p>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{{ 'section-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'media-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.featured_product",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:labels.media_position_on_large_screens",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:labels.media_proportions",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.match_each_image"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "mist"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "t:labels.show_on",
      "options": [
        {
          "value": "all",
          "label": "t:options.all_devices"
        },
        {
          "value": "mobile",
          "label": "t:options.small_screens_only"
        },
        {
          "value": "desktop",
          "label": "t:options.large_screens_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Text block</p>"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.text_style",
          "options": [
            {
              "value": "text-sm",
              "label": "t:options.body"
            },
            {
              "value": "subheading",
              "label": "t:options.subheading"
            },
            {
              "value": "text-lg",
              "label": "t:options.large"
            }
          ],
          "default": "subheading"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:names.title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "t:labels.size",
          "options": [
            {
              "value": "h1",
              "label": "t:options.large"
            },
            {
              "value": "h2",
              "label": "t:options.medium"
            },
            {
              "value": "h3",
              "label": "t:options.small"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "vendor",
      "name": "t:names.vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "t:names.price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_saving",
          "label": "t:labels.show_percentage_saved",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_installments",
          "label": "t:labels.show_installment_payments",
          "default": true
        }
      ]
    },
    {
      "type": "rating",
      "name": "t:names.product_rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "inventory",
      "name": "t:names.inventory_status",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "t:labels.show_remaining_quantity_when_stock_is_low",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:names.description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "t:names.variant_picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_style",
          "label": "t:labels.style",
          "options": [
            {
              "value": "buttons",
              "label": "t:options.buttons"
            },
            {
              "value": "dropdown",
              "label": "t:options.dropdown"
            }
          ],
          "default": "buttons"
        },
        {
          "type": "checkbox",
          "id": "show_swatches",
          "label": "t:labels.show_swatches",
          "default": true
        }
      ]
    },
    {
      "type": "quantity",
      "name": "t:names.quantity_selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "t:names.buy_buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:labels.show_accelerated_checkout_buttons",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "t:labels.show_gift_card_recipient_form",
          "default": true
        },
        {
          "type": "text",
          "id": "preorder_note",
          "label": "t:labels.pre_order_note",
          "default": "Ships when back in stock"
        }
      ]
    },
    {
      "type": "share",
      "name": "t:names.share",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "t:names.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:labels.custom_liquid",
          "info": "t:info.add_app_snippets_or_other_liquid_code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_product",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy_buttons"
        }
      ]
    }
  ]
}
{% endschema %}
