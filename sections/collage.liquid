{%- comment -%}
  Collage: a bento grid of up to five image tiles that link to collections,
  products, or pages. The first tile can span two rows.
{%- endcomment -%}

<div class="collage-section color-{{ section.settings.color_scheme }} visibility-{{ section.settings.visibility }}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {% render 'section-heading',
      subheading: section.settings.subheading,
      heading: section.settings.heading,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    %}

    <ul class="collage collage--{{ section.settings.layout }} collage--count-{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_image = block.settings.image
          assign tile_url = block.settings.link
          assign tile_heading = block.settings.heading
          if block.settings.collection != blank
            assign tile_image = tile_image | default: block.settings.collection.featured_image
            assign tile_url = tile_url | default: block.settings.collection.url
            assign tile_heading = tile_heading | default: block.settings.collection.title
          endif
          if forloop.first and section.settings.layout != 'even'
            assign tile_sizes = '(min-width: 990px) 50vw, 100vw'
          else
            assign tile_sizes = '(min-width: 990px) 25vw, 50vw'
          endif
        -%}
        <li class="collage__tile" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if tile_url != blank -%}<a href="{{ tile_url }}" class="collage__link">{%- else -%}<div class="collage__link">{%- endif -%}
            <span class="collage__media media">
              {%- if tile_image != blank -%}
                {%- liquid
                  assign tile_loading = 'lazy'
                  assign tile_priority = 'auto'
                  if section.index == 1 and forloop.index <= 2
                    assign tile_loading = 'eager'
                    assign tile_priority = 'high'
                  endif
                -%}
                {% render 'image', image: tile_image, sizes: tile_sizes, alt: tile_heading, loading: tile_loading, fetchpriority: tile_priority %}
              {%- else -%}
                {%- capture placeholder_name -%}{% cycle 'lifestyle-1', 'collection-2', 'collection-3', 'lifestyle-2', 'collection-4' %}{%- endcapture -%}
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="collage__content">
              {%- if block.settings.subheading != blank -%}
                <span class="subheading">{{ block.settings.subheading }}</span>
              {%- endif -%}
              {%- if tile_heading != blank -%}
                <span class="collage__heading h3">{{ tile_heading }}</span>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="collage__button button button--small button--surface">{{ block.settings.button_label }}</span>
              {%- endif -%}
            </span>
          {%- if tile_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.collage",
  "tag": "section",
  "class": "section-collage",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "feature-start",
          "label": "t:options.large_tile_on_the_left"
        },
        {
          "value": "feature-end",
          "label": "t:options.large_tile_on_the_right"
        },
        {
          "value": "even",
          "label": "t:options.even_tiles"
        }
      ],
      "default": "feature-start"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "t:labels.show_on",
      "options": [
        {
          "value": "all",
          "label": "t:options.all_devices"
        },
        {
          "value": "mobile",
          "label": "t:options.small_screens_only"
        },
        {
          "value": "desktop",
          "label": "t:options.large_screens_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:names.tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection",
          "info": "t:info.fills_in_the_image_heading_and_link_when_they_re_67e7ea"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:labels.subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.collage",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "heading": "Category"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Category"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Category"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Category"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Category"
          }
        }
      ]
    }
  ]
}
