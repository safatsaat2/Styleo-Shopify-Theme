{%- comment -%}
  Contact form built from field blocks. One section serves the contact
  page, quote requests, wholesale inquiries, return requests, and order
  questions. Submissions arrive as emails through Shopify's contact form,
  labeled with the form name. Fields can be prefilled from the page URL,
  for example ?product=Linen+shirt from a product page quote button.
{%- endcomment -%}

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign info_blocks = section.blocks | where: 'type', 'info'
  assign has_info = false
  if info_blocks.size > 0
    assign has_info = true
  endif
  assign default_success = 'contact.success' | t
  assign success_message = section.settings.success_message | default: default_success
  assign default_button = 'contact.send' | t
  assign button_label = section.settings.button_label | default: default_button
-%}

<div class="contact-section color-{{ section.settings.color_scheme }}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="contact{% if has_info %} contact--with-info{% endif %}">
      <div class="contact__main">
        {%- if section.settings.heading != blank or section.settings.text != blank -%}
          <div class="contact__intro">
            {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading }}</p>{%- endif -%}
            {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
          </div>
        {%- endif -%}

        <lc-prefill>
          {%- form 'contact', id: form_id, class: 'contact__form panel' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
                {% render 'icon', name: 'check' %}
                <span>{{ success_message }}</span>
              </p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
                {% render 'icon', name: 'error' %}
                <ul>
                  {%- for field in form.errors -%}
                    <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if section.settings.form_name != blank -%}
              <input type="hidden" name="contact[{{ 'contact.form_type' | t }}]" value="{{ section.settings.form_name | escape }}">
            {%- endif -%}

            <div class="contact__fields">
              <div class="field">
                <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
                <input id="{{ form_id }}-name" class="input" type="text" name="contact[{{ 'contact.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
              </div>
              <div class="field">
                <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
                <input
                  id="{{ form_id }}-email"
                  class="input"
                  type="email"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  required
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>

              {%- for block in section.blocks -%}
                {%- if block.type == 'info' or block.type == '@app' -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign field_id = form_id | append: '-' | append: block.id
                  assign field_name = 'contact[' | append: block.settings.label | append: ']'
                  if block.type == 'message'
                    assign field_name = 'contact[body]'
                  endif
                  assign wide = false
                  if block.type == 'message' or block.type == 'textarea' or block.settings.width == 'full'
                    assign wide = true
                  endif
                -%}
                <div class="field{% if wide %} field--full{% endif %}" {{ block.shopify_attributes }}>
                  {%- case block.type -%}
                    {%- when 'checkbox' -%}
                      <label class="checkbox" for="{{ field_id }}">
                        <input type="checkbox" id="{{ field_id }}" name="{{ field_name }}" value="{{ 'general.yes' | t }}"{% if block.settings.required %} required{% endif %}>
                        <span>{{ block.settings.label }}</span>
                      </label>
                    {%- when 'select' -%}
                      <label class="field__label" for="{{ field_id }}">{{ block.settings.label }}{% if block.settings.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                      <div class="select-wrapper">
                        <select id="{{ field_id }}" class="select" name="{{ field_name }}"{% if block.settings.required %} required aria-required="true"{% endif %}>
                          <option value="">{{ 'products.custom_field.choose' | t }}</option>
                          {%- assign choices = block.settings.options | split: ',' -%}
                          {%- for choice in choices -%}
                            <option value="{{ choice | strip | escape }}">{{ choice | strip }}</option>
                          {%- endfor -%}
                        </select>
                        {% render 'icon', name: 'chevron-down' %}
                      </div>
                    {%- when 'message', 'textarea' -%}
                      <label class="field__label" for="{{ field_id }}">{{ block.settings.label }}{% if block.settings.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                      <textarea
                        id="{{ field_id }}"
                        class="textarea"
                        name="{{ field_name }}"
                        rows="5"
                        {% if block.settings.required %}
                          required aria-required="true"
                        {% endif %}
                        {% if block.settings.prefill_param != blank %}
                          data-prefill="{{ block.settings.prefill_param | escape }}"
                        {% endif %}
                      >{% if block.type == 'message' %}{{ form.body }}{% endif %}</textarea>
                    {%- else -%}
                      <label class="field__label" for="{{ field_id }}">{{ block.settings.label }}{% if block.settings.required %} <span aria-hidden="true">*</span>{% endif %}</label>
                      <input
                        id="{{ field_id }}"
                        class="input"
                        type="{{ block.settings.input_type | default: 'text' }}"
                        name="{{ field_name }}"
                        {% if block.settings.required %}
                          required aria-required="true"
                        {% endif %}
                        {% if block.settings.prefill_param != blank %}
                          data-prefill="{{ block.settings.prefill_param | escape }}"
                        {% endif %}
                        {% if block.settings.input_type == 'tel' %}
                          autocomplete="tel"
                        {% endif %}
                      >
                  {%- endcase -%}
                  {%- if block.settings.hint != blank -%}
                    <span class="field__hint">{{ block.settings.hint }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            <div class="contact__submit">
              <button type="submit" class="button button--large">{{ button_label }}</button>
              <p class="field__hint">{{ 'contact.required_hint' | t }}</p>
            </div>
          {%- endform -%}
        </lc-prefill>
      </div>

      {%- if has_info -%}
        <aside class="contact__info" aria-label="{{ 'contact.info_label' | t }}">
          {%- for block in info_blocks -%}
            <div class="contact__info-item" {{ block.shopify_attributes }}>
              <span class="contact__info-icon">{% render 'icon', name: block.settings.icon %}</span>
              <div>
                <p class="contact__info-title">{{ block.settings.heading }}</p>
                <div class="rte text-sm text-muted">{{ block.settings.text }}</div>
              </div>
            </div>
          {%- endfor -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
          {%- endfor -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{{ 'section-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'content.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "form_name",
      "label": "t:labels.form_name",
      "info": "t:info.added_to_each_email_so_you_can_tell_forms_apart_cf7994",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:labels.confirmation_message",
      "default": "Thanks for reaching out. We'll reply within two business days."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "text_field",
      "name": "t:names.text_field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "Phone"
        },
        {
          "type": "select",
          "id": "input_type",
          "label": "t:labels.field_type",
          "options": [
            {
              "value": "text",
              "label": "t:options.text"
            },
            {
              "value": "tel",
              "label": "t:options.phone_number"
            },
            {
              "value": "number",
              "label": "t:options.number"
            },
            {
              "value": "url",
              "label": "t:options.website"
            },
            {
              "value": "date",
              "label": "t:options.date"
            }
          ],
          "default": "text"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:labels.width",
          "options": [
            {
              "value": "half",
              "label": "t:options.half"
            },
            {
              "value": "full",
              "label": "t:options.full"
            }
          ],
          "default": "half"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:labels.make_field_required",
          "default": false
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:labels.help_text"
        },
        {
          "type": "text",
          "id": "prefill_param",
          "label": "t:labels.fill_from_link",
          "info": "t:info.name_of_a_link_parameter_to_prefill_this_field_f_cfe034"
        }
      ]
    },
    {
      "type": "select",
      "name": "t:names.dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "Topic"
        },
        {
          "type": "text",
          "id": "options",
          "label": "t:labels.choices",
          "info": "t:info.separate_with_commas",
          "default": "Order question, Product question, Other"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:labels.width",
          "options": [
            {
              "value": "half",
              "label": "t:options.half"
            },
            {
              "value": "full",
              "label": "t:options.full"
            }
          ],
          "default": "half"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:labels.make_field_required",
          "default": false
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:labels.help_text"
        }
      ]
    },
    {
      "type": "checkbox",
      "name": "t:names.checkbox",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "I'm a business customer"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:labels.make_field_required",
          "default": false
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:labels.help_text"
        }
      ]
    },
    {
      "type": "textarea",
      "name": "t:names.long_text_field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "Details"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:labels.make_field_required",
          "default": false
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:labels.help_text"
        },
        {
          "type": "text",
          "id": "prefill_param",
          "label": "t:labels.fill_from_link",
          "info": "t:info.name_of_a_link_parameter_to_prefill_this_field"
        }
      ]
    },
    {
      "type": "message",
      "name": "t:names.message",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "Message"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:labels.make_field_required",
          "default": true
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:labels.help_text"
        }
      ]
    },
