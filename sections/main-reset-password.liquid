{%- comment -%}
  Legacy customer accounts: choose a new password from the reset email.
{%- endcomment -%}

<div class="customer customer--auth color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="customer__card panel">
      <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.reset.text' | t }}</p>
      {%- form 'reset_customer_password', class: 'customer__form' -%}
        {% render 'customer-form-errors', form: form %}
            <div class="field">
              <label class="field__label" for="ResetPassword">{{ 'customer.fields.new_password' | t }}</label>
              <input
                id="ResetPassword"
                class="input"
                type="password"
                name="customer[password]"
                autocomplete="new-password"
                required
                {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
              >
            </div>
            <div class="field">
              <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.fields.confirm_password' | t }}</label>
              <input
                id="ResetPasswordConfirm"
                class="input"
                type="password"
                name="customer[password_confirmation]"
                autocomplete="new-password"
                required
                {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
              >
            </div>
        <button type="submit" class="button button--full">{{ 'customer.reset.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.reset_password",
  "tag": "section",
  "class": "section-reset-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ]
}
{% endschema %}
