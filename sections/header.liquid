    {
      "type": "color_scheme",
      "id": "transparent_color_scheme",
      "label": "t:labels.transparent_color_scheme",
      "info": "t:info.only_the_text_and_icon_colors_are_used",
      "default": "dusk"
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "t:labels.menu_style",
      "options": [
        {
          "value": "dropdown",
          "label": "t:options.dropdown"
        },
        {
          "value": "mega",
          "label": "t:options.mega_menu"
        }
      ],
      "default": "dropdown"
    },
    {
      "type": "paragraph",
      "content": "t:content.add_mega_menu_promotions_to_show_images_next_to_e6ae81"
    },
    {
      "type": "text",
      "id": "drawer_button_label",
      "label": "t:labels.mobile_menu_button_label",
