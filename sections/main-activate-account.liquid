{%- comment -%}
  Legacy customer accounts: activate an account from an invitation.
{%- endcomment -%}

<div class="customer customer--auth color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="customer__card panel">
      <p class="subheading">{{ 'customer.activate.subheading' | t }}</p>
      <h1 class="h2">{{ 'customer.activate.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.activate.text' | t }}</p>
      {%- form 'activate_customer_password', class: 'customer__form' -%}
        {% render 'customer-form-errors', form: form %}
            <div class="field">
              <label class="field__label" for="ActivatePassword">{{ 'customer.fields.password' | t }}</label>
              <input
                id="ActivatePassword"
                class="input"
                type="password"
                name="customer[password]"
                autocomplete="new-password"
                required
                {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
              >
            </div>
            <div class="field">
              <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.fields.confirm_password' | t }}</label>
              <input
                id="ActivatePasswordConfirm"
                class="input"
                type="password"
                name="customer[password_confirmation]"
                autocomplete="new-password"
                required
                {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
              >
            </div>
        <div class="button-row">
          <button type="submit" class="button">{{ 'customer.activate.submit' | t }}</button>
          <button type="submit" class="button button--outline" name="decline" formnovalidate>{{ 'customer.activate.decline' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{{ 'section-customer.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.activate_account",
  "tag": "section",
  "class": "section-activate-account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ]
}
{% endschema %}
