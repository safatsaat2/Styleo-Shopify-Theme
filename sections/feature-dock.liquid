{%- comment -%}
  Feature dock: a pill-shaped bar of short service promises that can float
  over the bottom edge of the section above it.
{%- endcomment -%}

{%- if section.settings.overlap -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 5;
    }
  {%- endstyle -%}
{%- endif -%}

<div class="dock-section visibility-{{ section.settings.visibility }}{% if section.settings.overlap %} dock-section--overlap{% endif %}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <ul class="dock dock--{{ section.settings.style }} color-{{ section.settings.color_scheme }}" role="list" data-reveal>
      {%- for block in section.blocks -%}
        <li class="dock__item" {{ block.shopify_attributes }}>
          {%- capture item_inner -%}
            <span class="dock__icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 24, height: 24, widths: '24, 48, 96', sizes: '24px' }}
              {%- else -%}
                {% render 'icon', name: block.settings.icon %}
              {%- endif -%}
            </span>
            <span class="dock__text">
              <span class="dock__heading">{{ block.settings.heading }}</span>
              {%- if block.settings.text != blank -%}
                <span class="dock__description">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="dock__link">{{ item_inner }}</a>
          {%- else -%}
            <div class="dock__link">{{ item_inner }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{{ 'section-home.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.feature_dock",
  "tag": "section",
  "class": "section-feature-dock",
  "max_blocks": 4,
  "settings": [
