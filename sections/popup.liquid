{%- comment -%}
  Popup for an email signup or a promotion. Merchant controlled: off by
  default, delay or exit intent, and a frequency limit per customer.
{%- endcomment -%}

{%- liquid
  assign show_here = section.settings.enabled
  if section.settings.pages == 'home' and request.page_type != 'index'
    assign show_here = false
  endif
  if request.page_type == 'cart' or request.page_type == 'password'
    assign show_here = false
  endif
  if request.design_mode
    assign show_here = true
  endif

  assign form_id = 'PopupNewsletter-' | append: section.id
  assign key = section.settings.heading | append: section.settings.type | md5 | slice: 0, 8
-%}

{%- if show_here -%}
  <lc-popup
    data-section-id="{{ section.id }}"
    data-key="{{ key }}"
    data-delay="{{ section.settings.delay }}"
    data-frequency="{{ section.settings.frequency }}"
    data-exit-intent="{{ section.settings.exit_intent }}"
  >
    <lc-dialog id="Popup-{{ section.id }}">
      <dialog
        class="dialog dialog--modal popup color-{{ section.settings.color_scheme }}{% if section.settings.image != blank %} popup--has-image{% endif %}"
        aria-labelledby="PopupHeading-{{ section.id }}"
        style="--dialog-width: {% if section.settings.image != blank %}52rem{% else %}32rem{% endif %};"
      >
        <div class="popup__layout">
          {%- if section.settings.image != blank -%}
            <div class="popup__media media">
              {% render 'image', image: section.settings.image, sizes: '(min-width: 750px) 26rem, 100vw', loading: 'lazy' %}
            </div>
          {%- endif -%}
          <div class="popup__content">
            <button type="button" class="icon-button popup__close" data-dialog-close aria-label="{{ 'general.close' | t }}">
              {% render 'icon', name: 'close' %}
            </button>
            {%- if section.settings.subheading != blank -%}
              <p class="subheading">{{ section.settings.subheading }}</p>
            {%- endif -%}
            <h2 id="PopupHeading-{{ section.id }}" class="h2">{{ section.settings.heading }}</h2>
            {%- if section.settings.text != blank -%}
              <div class="rte popup__text">{{ section.settings.text }}</div>
            {%- endif -%}

            {%- if section.settings.type == 'newsletter' -%}
              {% render 'newsletter-form', id: form_id, button_label: section.settings.button_label %}
            {%- else -%}
              {%- if section.settings.discount_code != blank -%}
                <p class="popup__code">
                  <span class="visually-hidden">{{ 'sections.popup.code_label' | t }}</span>
                  <code>{{ section.settings.discount_code | escape }}</code>
                </p>
              {%- endif -%}
              {% render 'button', label: section.settings.button_label, url: section.settings.button_link, arrow: true %}
            {%- endif -%}

            <button type="button" class="popup__dismiss" data-dialog-close>{{ 'sections.popup.no_thanks' | t }}</button>
          </div>
        </div>
      </dialog>
    </lc-dialog>
  </lc-popup>

  {{ 'section-home.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'popup.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:names.popup",
  "class": "section-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:labels.show_popup",
      "default": false
    },
    {
      "type": "select",
      "id": "type",
      "label": "t:labels.content",
      "options": [
        {
          "value": "newsletter",
          "label": "t:options.email_signup"
        },
        {
          "value": "promotion",
          "label": "t:options.promotion"
        }
      ],
      "default": "newsletter"
    },
    {
      "type": "select",
      "id": "pages",
      "label": "t:labels.show_on",
      "options": [
        {
          "value": "all",
          "label": "t:options.all_pages"
        },
        {
          "value": "home",
          "label": "t:options.home_page_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "t:labels.delay",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "t:labels.also_show_when_customers_move_to_leave",
      "info": "t:info.applies_on_large_screens_with_a_mouse",
      "default": false
    },
    {
      "type": "range",
      "id": "frequency",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "label": "t:labels.show_again_after",
      "default": 14
    },
    {
      "type": "header",
      "content": "t:content.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Join our list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Hear about new arrivals and offers first.</p>"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "t:labels.discount_code",
      "info": "t:info.shown_with_the_promotion_content_create_the_code_fca79d"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "info": "t:info.used_with_the_promotion_content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "paper"
    }
  ]
}
{% endschema %}
