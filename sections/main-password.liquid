{%- comment -%}
  Password page: logo or store name, the password message, an email
  signup, and the storefront password form in a dialog.
{%- endcomment -%}

<div class="password color-{{ section.settings.color_scheme }}">
  <span class="glow password__glow password__glow--one" aria-hidden="true"></span>
  <span class="glow password__glow password__glow--two" aria-hidden="true"></span>

  <header class="password__header page-width">
    <div class="password__logo">
      {%- if settings.logo_inverse != blank -%}
        {{ settings.logo_inverse | image_url: width: 600 | image_tag: alt: shop.name, class: 'password__logo-image', widths: '160, 240, 320, 480, 600', sizes: '200px' }}
      {%- elsif settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'password__logo-image', widths: '160, 240, 320, 480, 600', sizes: '200px' }}
      {%- else -%}
        <span class="logo__text">{{ shop.name }}</span>
      {%- endif -%}
    </div>
    <button type="button" class="button button--outline button--small password__open" data-dialog-open="PasswordDialog" aria-haspopup="dialog">
      {% render 'icon', name: 'account' %}
      {{ 'general.password_page.enter_password' | t }}
    </button>
  </header>

  <div class="password__main page-width">
    <div class="password__content">
      {%- if section.settings.image != blank -%}
        <div class="password__media">
          {% render 'media-halo', image: section.settings.image, shape: 'orb', ratio: '1 / 1', sizes: '320px', loading: 'eager' %}
        </div>
      {%- else -%}
        <span class="password__orb" aria-hidden="true"></span>
      {%- endif -%}
      <p class="subheading">{{ section.settings.subheading }}</p>
      {%- assign default_heading = 'general.password_page.heading' | t -%}
      <h1 class="h0 text-balance">{{ section.settings.heading | default: default_heading }}</h1>
      {%- if shop.password_message != blank -%}
        <div class="password__message rte">{{ shop.password_message }}</div>
      {%- endif -%}
      {%- if section.settings.show_newsletter -%}
        <div class="password__newsletter">
          {% render 'newsletter-form', id: 'PasswordNewsletter', button_label: section.settings.newsletter_button %}
        </div>
      {%- endif -%}
      {% render 'social-icons', class: 'password__social' %}
    </div>
  </div>

  <footer class="password__footer page-width">
    <p>
      {{ 'general.password_page.powered_by' | t }}
      {{ powered_by_link }}
    </p>
    <p>
      {{ 'general.password_page.store_owner' | t }}
      <a href="/admin" class="link" rel="nofollow">{{ 'general.password_page.login_link' | t }}</a>
    </p>
  </footer>

  <lc-dialog id="PasswordDialog">
    <dialog class="dialog dialog--modal color-{{ settings.overlay_color_scheme }}" aria-labelledby="PasswordDialogTitle" style="--dialog-width: 28rem;">
      <div class="password__dialog">
        <button type="button" class="icon-button password__dialog-close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
        <h2 id="PasswordDialogTitle" class="h3">{{ 'general.password_page.enter_password' | t }}</h2>
        {%- form 'storefront_password', class: 'password__form' -%}
          <div class="field">
            <label class="field__label" for="PasswordInput">{{ 'general.password_page.password_label' | t }}</label>
            <input
              id="PasswordInput"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="PasswordError"
              {% endif %}
              data-dialog-focus
            >
          </div>
          {%- if form.errors -%}
            <p id="PasswordError" class="form-message form-message--error" role="alert" data-password-error>
              {% render 'icon', name: 'error' %}
              <span>{{ 'general.password_page.wrong_password' | t }}</span>
            </p>
          {%- endif -%}
          <button type="submit" class="button button--full">{{ 'general.password_page.submit' | t }}</button>
        {%- endform -%}
      </div>
    </dialog>
  </lc-dialog>
</div>

{{ 'section-content.css' | asset_url | stylesheet_tag }}

<script>
  // Reopen the dialog after a wrong password so the error is visible.
  if (document.querySelector('[data-password-error]')) {
    customElements.whenDefined('lc-dialog').then(() => document.getElementById('PasswordDialog').open());
  }
</script>

{% schema %}
{
  "name": "t:names.password_page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.a_cut_out_png_works_well_in_front_of_the_orb"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Something new is on its way"
    },
    {
      "type": "paragraph",
      "content": "t:content.edit_the_message_below_the_heading_in_your_store_7a8aa0"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.show_email_signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "t:labels.signup_button_label",
      "default": "Notify me"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "dusk"
    }
  ]
}
{% endschema %}
