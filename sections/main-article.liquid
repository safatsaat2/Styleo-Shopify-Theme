{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign reading_minutes = word_count | divided_by: 200.0 | ceil | at_least: 1
-%}

<article class="article color-{{ section.settings.color_scheme }}">
  <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'image' -%}
          {%- if article.image -%}
            <div class="article__hero article__hero--{{ block.settings.shape }}" {{ block.shopify_attributes }}>
              {% render 'media-halo',
                image: article.image,
                shape: block.settings.shape,
                ratio: '16 / 9',
                sizes: '(min-width: 1280px) 1200px, 100vw',
                loading: 'eager',
                fetchpriority: 'high'
              %}
            </div>
          {%- endif -%}

        {%- when 'title' -%}
          <header class="article__header" {{ block.shopify_attributes }}>
            {%- if block.settings.show_breadcrumbs -%}
              {% render 'breadcrumbs', class: 'article__breadcrumbs' %}
            {%- endif -%}
            {%- if article.tags.size > 0 -%}
              <p class="subheading">{{ article.tags.first }}</p>
            {%- endif -%}
            <h1 class="article__title h1 text-balance">{{ article.title | escape }}</h1>
            <p class="article__meta">
              {%- if block.settings.show_date -%}
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
              {%- endif -%}
              {%- if block.settings.show_author and article.author != blank -%}
                <span>{{ 'blogs.by_author' | t: author: article.author }}</span>
              {%- endif -%}
              {%- if block.settings.show_reading_time -%}
                <span>{{ 'blogs.reading_time' | t: count: reading_minutes }}</span>
              {%- endif -%}
            </p>
          </header>

        {%- when 'content' -%}
          <div class="article__body{% if block.settings.show_toc %} article__body--toc{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.show_toc -%}
              <lc-toc class="article__toc" data-target="#ArticleContent-{{ section.id }}" hidden>
                <nav aria-labelledby="TocTitle-{{ section.id }}">
                  <p id="TocTitle-{{ section.id }}" class="h6 article__toc-title">{{ 'blogs.table_of_contents' | t }}</p>
                  <ol class="article__toc-list" role="list" data-toc-list></ol>
                </nav>
              </lc-toc>
            {%- endif -%}
            <div id="ArticleContent-{{ section.id }}" class="article__content rte">
              {{- article.content -}}
            </div>
          </div>

        {%- when 'products' -%}
          {%- if block.settings.products.size > 0 -%}
            <aside class="article__products" aria-labelledby="ShopStory-{{ block.id }}" {{ block.shopify_attributes }}>
              <h2 id="ShopStory-{{ block.id }}" class="h3">{{ block.settings.heading }}</h2>
              <ul class="results-grid" role="list" style="--cols: 4; --cols-mobile: 2;">
                {%- for product in block.settings.products limit: 4 -%}
                  <li>{% render 'product-card', product: product, index: forloop.index0, section_id: block.id %}</li>
                {%- endfor -%}
              </ul>
            </aside>
          {%- endif -%}

        {%- when 'tags' -%}
          {%- if article.tags.size > 0 -%}
            <ul class="article__tags cluster" role="list" aria-label="{{ 'blogs.tags' | t }}" {{ block.shopify_attributes }}>
              {%- for tag in article.tags -%}
                <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip">{{ tag }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- when 'share' -%}
          <div class="article__share" {{ block.shopify_attributes }}>
            {%- assign share_url = request.origin | append: article.url -%}
            {% render 'share-buttons', url: share_url, title: article.title, image: article.image %}
          </div>

        {%- when 'author' -%}
          {%- assign bio = block.settings.bio -%}
          {%- if bio != blank or article.author != blank -%}
            <aside class="article__author panel" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160, height: 160, crop: 'center' | image_tag: class: 'article__author-image', loading: 'lazy', alt: '', widths: '80, 160', sizes: '80px' }}
              {%- endif -%}
              <div>
                <p class="subheading">{{ 'blogs.written_by' | t }}</p>
                <p class="h4">{{ article.author }}</p>
                {%- if bio != blank -%}<div class="rte text-sm">{{ bio }}</div>{%- endif -%}
              </div>
            </aside>
          {%- endif -%}

        {%- when 'related' -%}
          {%- assign related_count = 0 -%}
          {%- capture related_items -%}
            {%- for candidate in blog.articles limit: 30 -%}
              {%- if candidate.id == article.id -%}{%- continue -%}{%- endif -%}
              {%- assign shares_tag = false -%}
              {%- for tag in article.tags -%}
                {%- if candidate.tags contains tag -%}{%- assign shares_tag = true -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              {%- if shares_tag or article.tags.size == 0 -%}
                {%- assign related_count = related_count | plus: 1 -%}
                <li>{% render 'article-card', article: candidate, show_excerpt: false, index: forloop.index0, heading_tag: 'h3' %}</li>
              {%- endif -%}
              {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if related_count > 0 -%}
            <aside class="article__related" aria-labelledby="Related-{{ block.id }}" {{ block.shopify_attributes }}>
              <h2 id="Related-{{ block.id }}" class="h3">{{ block.settings.heading }}</h2>
              <ul class="blog__grid" role="list" style="--cols: 3;">{{ related_items }}</ul>
            </aside>
          {%- endif -%}

        {%- when 'comments' -%}
          {%- if blog.comments_enabled? -%}
            <section class="article__comments" aria-labelledby="Comments-{{ section.id }}" {{ block.shopify_attributes }}>
              <h2 id="Comments-{{ section.id }}" class="h3">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>

              {%- paginate article.comments by 10 -%}
                {%- if article.comments_count > 0 -%}
                  <ol class="article__comment-list" role="list">
                    {%- for comment in article.comments -%}
                      <li class="comment panel" id="{{ comment.id }}">
                        <p class="comment__author">{{ comment.author | escape }}</p>
                        <time class="comment__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: format: 'date' }}</time>
                        <div class="rte comment__body">{{ comment.content }}</div>
                      </li>
                    {%- endfor -%}
                  </ol>
                  {% render 'pagination', paginate: paginate, style: 'pages' %}
                {%- endif -%}
              {%- endpaginate -%}

              {%- form 'new_comment', article, class: 'comment-form' -%}
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
                    {% render 'icon', name: 'check' %}
                    <span>
                      {%- if blog.moderated? -%}
                        {{ 'blogs.comments.success_moderated' | t }}
                      {%- else -%}
                        {{ 'blogs.comments.success' | t }}
                      {%- endif -%}
                    </span>
                  </p>
                {%- endif -%}
                {%- if form.errors -%}
                  <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
                    {% render 'icon', name: 'error' %}
                    <ul>
                      {%- for field in form.errors -%}
                        <li>
                          {%- if field == 'form' -%}
                            {{ form.errors.messages[field] }}
                          {%- else -%}
                            {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                <p class="h4 comment-form__title">{{ 'blogs.comments.leave' | t }}</p>
                <div class="comment-form__row">
                  <div class="field">
                    <label class="field__label" for="CommentAuthor-{{ section.id }}">{{ 'blogs.comments.name' | t }}</label>
                    <input id="CommentAuthor-{{ section.id }}" class="input" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required aria-required="true"{% if form.errors contains 'author' %} aria-invalid="true"{% endif %}>
                  </div>
                  <div class="field">
                    <label class="field__label" for="CommentEmail-{{ section.id }}">{{ 'blogs.comments.email' | t }}</label>
                    <input id="CommentEmail-{{ section.id }}" class="input" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
                  </div>
                </div>
                <div class="field">
                  <label class="field__label" for="CommentBody-{{ section.id }}">{{ 'blogs.comments.message' | t }}</label>
                  <textarea id="CommentBody-{{ section.id }}" class="textarea" name="comment[body]" rows="5" required aria-required="true"{% if form.errors contains 'body' %} aria-invalid="true"{% endif %}>{{ form.body }}</textarea>
                </div>
                {%- if blog.moderated? -%}
                  <p class="field__hint">{{ 'blogs.comments.moderated' | t }}</p>
                {%- endif -%}
                <button type="submit" class="button">{{ 'blogs.comments.post' | t }}</button>
              {%- endform -%}
            </section>
          {%- endif -%}

        {%- when 'custom_liquid' -%}
          <div class="article__liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- when '@app' -%}
          <div class="article__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "url": {{ request.origin | append: article.url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    {%- if article.image -%}
      "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    },
    "wordCount": {{ word_count }}
  }
</script>

{{ 'section-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'content.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.blog_post",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:names.featured_image",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "shape",
          "label": "t:labels.image_shape",
          "options": [
            {
              "value": "frame",
              "label": "t:options.rounded_frame"
            },
            {
              "value": "none",
              "label": "t:options.none"
            }
          ],
          "default": "frame"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:names.title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "t:labels.show_date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "label": "t:labels.show_author",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_reading_time",
          "label": "t:labels.show_reading_time",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_breadcrumbs",
          "label": "t:labels.show_breadcrumbs",
          "default": false
        }
      ]
    },
    {
      "type": "content",
      "name": "t:names.content",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_toc",
          "label": "t:labels.show_table_of_contents",
          "info": "t:info.built_from_the_headings_in_the_post_when_there_a_c21b27",
          "default": true
        }
      ]
    },
    {
      "type": "products",
      "name": "t:names.shop_the_story",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shop the story"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "t:labels.products",
          "info": "t:info.connect_a_product_list_metafield_to_show_product_3a817c",
          "limit": 4
        }
      ]
    },
    {
      "type": "tags",
      "name": "t:names.tags",
      "limit": 1,
      "settings": []
    },
    {
      "type": "share",
      "name": "t:names.share",
      "limit": 1,
      "settings": []
    },
    {
      "type": "author",
      "name": "t:names.author",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.photo"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "t:labels.bio",
          "info": "t:info.connect_a_metafield_to_show_a_different_bio_for_5504a4"
        }
      ]
    },
    {
      "type": "related",
      "name": "t:names.related_posts",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Keep reading"
        }
      ]
    },
    {
      "type": "comments",
      "name": "t:names.comments",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "t:names.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:labels.custom_liquid",
          "info": "t:info.add_app_snippets_or_other_liquid_code"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
