<div class="not-found color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow section-spacing not-found__inner" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <p class="subheading">404</p>
    <h1 class="h1">{{ 'not_found.heading' | t }}</h1>
    <p class="text-muted not-found__text">{{ 'not_found.text' | t }}</p>

    {%- if section.settings.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search">
        <label for="NotFoundSearch" class="visually-hidden">{{ 'search.label' | t }}</label>
        <div class="inline-field">
          <input id="NotFoundSearch" class="input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="button button--secondary button--icon" aria-label="{{ 'search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
        </div>
      </form>
    {%- endif -%}

    <div class="button-row not-found__buttons">
      <a href="{{ routes.root_url }}" class="button">{{ 'not_found.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="button button--outline">{{ 'not_found.shop' | t }}</a>
    </div>
  </div>
</div>

{{ 'section-content.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "t:names.page_not_found",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search_field",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "cream"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom",
      "default": 80
    }
  ]
}
{% endschema %}
