{%- comment -%}
  Main product section. Every element of the product information column
  is a block. When rendered by the Product Recommendations API
  (intent=complementary) it outputs only the complementary product lists.
{%- endcomment -%}

{%- if recommendations.performed -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'complementary' -%}
      <div data-complementary="{{ block.id }}">
        {%- if recommendations.products_count > 0 -%}
          <p class="complementary__heading h5">{{ block.settings.heading }}</p>
          <ul class="complementary__list" role="list">
            {%- for recommendation in recommendations.products -%}
              <li>
                {% render 'product-card',
                  product: recommendation,
                  style: 'row',
                  style_mobile: 'row',
                  sizes: '112px',
                  section_id: block.id,
                  heading_tag: 'p'
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- liquid
    assign form_id = 'ProductForm-' | append: section.id
    assign variant = product.selected_or_first_available_variant
    assign priority = 'auto'
    if section.index <= 2
      assign priority = 'high'
    endif
    case section.settings.media_width
      when 'wide'
        assign media_sizes = '(min-width: 1280px) 760px, (min-width: 990px) 58vw, 100vw'
      else
        assign media_sizes = '(min-width: 1280px) 640px, (min-width: 990px) 50vw, 100vw'
    endcase
    if section.settings.gallery_layout == 'grid'
      assign media_sizes = '(min-width: 1280px) 380px, (min-width: 990px) 28vw, 100vw'
    endif
  -%}

  <lc-product
    class="product product--{{ section.settings.gallery_layout }} product--media-{{ section.settings.media_width }} color-{{ section.settings.color_scheme }}"
    data-section-id="{{ section.id }}"
    data-render-section="{{ section.id }}"
    data-product-url="{{ product.url }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-url-sync="true"
    data-track-recent="true"
    data-variant-id="{{ variant.id }}"
    data-variant-media-id="{{ variant.featured_media.id }}"
  >
    <div class="page-width section-spacing" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
      {%- if section.settings.show_breadcrumbs -%}
        {% render 'breadcrumbs', class: 'product__breadcrumbs' %}
      {%- endif -%}

      <div class="product__grid">
        <div class="product__media">
          {% render 'product-gallery',
            product: product,
            section: section,
            layout: section.settings.gallery_layout,
            ratio: section.settings.media_ratio,
            zoom: section.settings.zoom,
            loop_video: section.settings.loop_video,
            priority: priority,
            sizes: media_sizes
          %}
        </div>

        <div class="product__info">
          <div class="product__info-inner{% if section.settings.sticky_info %} product__info-inner--sticky{% endif %}">
            {% render 'product-info-blocks', product: product, section: section, form_id: form_id, context: 'main' %}
          </div>
        </div>
      </div>
    </div>

    {%- if section.settings.sticky_add_to_cart -%}
      <lc-sticky-atc class="sticky-atc color-{{ section.settings.sticky_color_scheme }}" hidden>
        <div class="sticky-atc__inner">
          <div class="sticky-atc__media media" style="--ratio: 1 / 1;">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120', sizes: '48px' }}
            {%- endif -%}
          </div>
          <div class="sticky-atc__text">
            <p class="sticky-atc__title">{{ product.title | escape }}</p>
            <div class="sticky-atc__details" data-product-part="sticky">
              {%- unless product.has_only_default_variant -%}
                <span class="sticky-atc__variant">{{ variant.title | escape }}</span>
              {%- endunless -%}
              <span class="sticky-atc__price">{{ variant.price | money }}</span>
            </div>
          </div>
          <div class="sticky-atc__action" data-product-part="sticky-action">
            {%- if variant.available -%}
              <button type="submit" form="{{ form_id }}" class="button" data-sticky-submit>
                {{- 'products.add_to_cart' | t -}}
              </button>
            {%- else -%}
              <button type="button" class="button" disabled>{{ 'products.buttons.sold_out' | t }}</button>
            {%- endif -%}
          </div>
        </div>
      </lc-sticky-atc>
    {%- endif -%}
  </lc-product>

  {% render 'product-structured-data', product: product %}

  {{ 'section-product.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'media-gallery.js' | asset_url }}" defer></script>
  <script src="{{ 'product.js' | asset_url }}" defer></script>
{%- endif -%}

