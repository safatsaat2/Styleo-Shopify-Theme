{%- comment -%}
  Email signup using Shopify's customer form. New subscribers are saved
  as customers who accept email marketing, tagged "newsletter".

  Accepts:
  - id {String}: unique form id (required)
  - button_label {String}: optional visible label; an arrow icon is used when blank
  - class {String}
{%- endcomment -%}

{%- assign form_id = id | default: 'Newsletter' -%}

{%- form 'customer', id: form_id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  {%- if form.posted_successfully? -%}
    <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
      {% render 'icon', name: 'check' %}
      <span>{{ 'newsletter.success' | t }}</span>
    </p>
  {%- else -%}
    <div class="inline-field newsletter-form__field {{ class }}">
      <label for="{{ form_id }}-email" class="visually-hidden">{{ 'newsletter.email_label' | t }}</label>
      <input
        id="{{ form_id }}-email"
        class="input"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ 'newsletter.placeholder' | t }}"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        aria-required="true"
        {% if form.errors %}
          aria-invalid="true" aria-describedby="{{ form_id }}-error"
        {% endif %}
      >
      {%- if button_label != blank -%}
        <button type="submit" class="button button--secondary">{{ button_label | escape }}</button>
      {%- else -%}
        <button type="submit" class="button button--secondary button--icon" aria-label="{{ 'newsletter.subscribe' | t }}">
          {% render 'icon', name: 'arrow-right' %}
        </button>
      {%- endif -%}
    </div>

    {%- if form.errors -%}
      <p id="{{ form_id }}-error" class="form-message form-message--error newsletter-form__error">
        {% render 'icon', name: 'error' %}
        <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
      </p>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
