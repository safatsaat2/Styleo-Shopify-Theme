  {%- when 'list' -%}
    <svg {{ attrs }}><rect x="4" y="4.5" width="5" height="5" rx="1"/><rect x="4" y="14.5" width="5" height="5" rx="1"/><path d="M12 6h8M12 8.5h5M12 16h8M12 18.5h5"/></svg>
  {%- when 'mail' -%}
    <svg {{ attrs }}><rect x="3.75" y="5.75" width="16.5" height="12.5" rx="2"/><path d="M4.5 7l7.5 6 7.5-6"/></svg>
  {%- when 'phone' -%}
    <svg {{ attrs }}><path d="M6.5 3.75h2.75l1.5 4.25-2 1.25a10 10 0 006 6l1.25-2 4.25 1.5v2.75a2 2 0 01-2 2A16.25 16.25 0 014.5 5.75a2 2 0 012-2z"/></svg>
