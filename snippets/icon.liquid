{%- comment -%}
  Inline SVG icons drawn on a 24px grid with a 1.5px stroke.
  Decorative by default (aria-hidden). Pass a label to the parent control,
  not to the icon.

  Accepts:
  - name {String}: icon name
  - class {String}: optional extra class

  Usage:
  {% render 'icon', name: 'bag' %}
{%- endcomment -%}

{%- capture attrs -%}
  class="icon icon--{{ name }} {{ class }}" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
{%- endcapture -%}

{%- case name -%}
  {%- when 'arrow-right' -%}
    <svg {{ attrs }}><path d="M4.5 12h15M13.5 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg {{ attrs }}><path d="M19.5 12h-15M10.5 6l-6 6 6 6"/></svg>
  {%- when 'arrow-up' -%}
    <svg {{ attrs }}><path d="M12 19.5v-15M6 10.5l6-6 6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }}><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg {{ attrs }}><path d="M15 6l-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ attrs }}><path d="M9 6l6 6-6 6"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M3.75 7h16.5M3.75 12h16.5M3.75 17h10.5"/></svg>
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="10.75" cy="10.75" r="6.25"/><path d="M15.5 15.5l4.75 4.75"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8" r="3.75"/><path d="M4.75 20.25c.9-3.6 3.75-5.5 7.25-5.5s6.35 1.9 7.25 5.5"/></svg>
  {%- when 'bag' -%}
    <svg {{ attrs }}><path d="M5.25 7.75h13.5l-1 12.5H6.25l-1-12.5z"/><path d="M8.75 9.5V6.75a3.25 3.25 0 016.5 0V9.5"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }}><path d="M12 5.25v13.5M5.25 12h13.5"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }}><path d="M5.25 12h13.5"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  {%- when 'error' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.25"/><path d="M12 7.75v5M12 16.25v.01"/></svg>
  {%- when 'info' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.25"/><path d="M12 11v5.25M12 7.75v.01"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M2.75 6.25h11v9.5h-11zM13.75 9.75h3.75l3 3.25v2.75h-6.75"/><circle cx="6.75" cy="17.25" r="1.75"/><circle cx="17" cy="17.25" r="1.75"/></svg>
  {%- when 'return' -%}
    <svg {{ attrs }}><path d="M4.5 9.75h10.25a4.75 4.75 0 010 9.5H8.5"/><path d="M8.25 5.75l-4 4 4 4"/></svg>
  {%- when 'shield' -%}
