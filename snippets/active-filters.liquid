{%- comment -%}
  Removable pills for applied filters and a "clear all" link.

  Accepts:
  - results {Collection|Search}
  - clear_url {String}: URL with filters removed and sort kept
{%- endcomment -%}

{%- liquid
  assign has_active = false
  for filter in results.filters
    if filter.active_values.size > 0
      assign has_active = true
    elsif filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active = true
      endif
    endif
  endfor
-%}

<div class="active-filters" data-facets-region="active">
  {%- if has_active -%}
    <ul class="active-filters__list" role="list" aria-label="{{ 'collections.filters.active' | t }}">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <li>
            <a href="{{ value.url_to_remove }}" class="chip is-active active-filters__pill" data-facet-link>
              <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
              {{ filter.label | escape }}: {{ value.label | escape }}
              {% render 'icon', name: 'close' %}
            </a>
          </li>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
            <li>
              <a href="{{ filter.url_to_remove }}" class="chip is-active active-filters__pill" data-facet-link>
                <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                {%- if filter.min_value.value != blank -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                –
                {%- if filter.max_value.value != blank -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                {% render 'icon', name: 'close' %}
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <li>
        <a href="{{ clear_url }}" class="active-filters__clear link" data-facet-link>{{ 'collections.filters.clear_all' | t }}</a>
      </li>
    </ul>
  {%- endif -%}
</div>
