{%- comment -%}
  Pagination in three styles. "Load more" and "infinite" use a real link to
  the next page, so they work without JavaScript.

  Accepts:
  - paginate {Paginate}
  - style {String}: 'pages' (default), 'load_more', or 'infinite'
  - item_label {String}: translated noun for the progress text, such as "products"
{%- endcomment -%}

{%- assign pagination_style = style | default: 'pages' -%}

<div class="pagination pagination--{{ pagination_style }}" data-facets-region="pagination">
  {%- if paginate.pages > 1 -%}
    {%- if pagination_style == 'pages' -%}
      <nav aria-label="{{ 'general.pagination.label' | t }}">
        <ul class="pagination__list" role="list">
          {%- if paginate.previous -%}
            <li>
              <a href="{{ paginate.previous.url }}" class="pagination__link pagination__link--arrow" data-facet-link aria-label="{{ 'general.pagination.previous' | t }}">
                {% render 'icon', name: 'chevron-left' %}
              </a>
            </li>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__link" data-facet-link aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="pagination__link pagination__link--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
              {%- else -%}
                <span class="pagination__link pagination__link--gap">{{ part.title }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- if paginate.next -%}
            <li>
              <a href="{{ paginate.next.url }}" class="pagination__link pagination__link--arrow" data-facet-link aria-label="{{ 'general.pagination.next' | t }}">
                {% render 'icon', name: 'chevron-right' %}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    {%- else -%}
      {%- liquid
        assign shown = paginate.current_offset | plus: paginate.page_size
        if shown > paginate.items
          assign shown = paginate.items
        endif
        assign progress = shown | times: 100 | divided_by: paginate.items
      -%}
      <div class="pagination__progress">
        <p class="pagination__progress-text">{{ 'general.pagination.showing' | t: shown: shown, total: paginate.items, items: item_label }}</p>
        <span class="pagination__bar" aria-hidden="true"><span style="width: {{ progress }}%;"></span></span>
      </div>
      {%- if paginate.next -%}
        <a
          href="{{ paginate.next.url }}"
          class="button button--outline pagination__more"
          data-load-more
          {% if pagination_style == 'infinite' %}
            data-infinite
          {% endif %}
        >
          {{- 'general.pagination.load_more' | t -}}
        </a>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
</div>
