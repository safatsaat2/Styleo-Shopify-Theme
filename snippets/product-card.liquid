{%- comment -%}
  Product card in three styles: portrait (grid), row (list), compact.
  Desktop and mobile styles are independent.

  Accepts:
  - product {Product}: when blank, a placeholder card renders (for presets)
  - style {String}: desktop style, defaults to the theme setting
  - style_mobile {String}: mobile style, defaults to the theme setting
  - sizes {String}: image sizes attribute
  - loading {String}: 'lazy' (default) or 'eager'
  - index {Number}: position, used to stagger reveal animations
  - section_id {String}: owning section id, for unique form ids
  - heading_tag {String}: default 'h3'
{%- endcomment -%}

{%- liquid
  assign desktop_style = style | default: settings.card_style
  assign mobile_style = style_mobile | default: settings.card_style_mobile
  assign title_tag = heading_tag | default: 'h3'
  assign image_sizes = sizes | default: '(min-width: 1280px) 300px, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign image_loading = loading | default: 'lazy'
  assign reveal_index = index | default: 0 | modulo: 4

  case settings.card_image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'adapt'
      if product.featured_media
        assign ratio = product.featured_media.aspect_ratio
      else
        assign ratio = '3 / 4'
      endif
    else
      assign ratio = '3 / 4'
  endcase
-%}

{%- if product == blank -%}
  <article class="card card--{{ desktop_style }}-desktop card--{{ mobile_style }}-mobile card--placeholder" data-reveal style="--reveal-index: {{ reveal_index }};">
    <div class="card__media-wrap">
      <div class="card__media media" style="--ratio: {{ ratio }};">
        {%- assign placeholder_number = reveal_index | plus: 1 -%}
        {%- assign placeholder_name = 'product-' | append: placeholder_number -%}
        {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
    <div class="card__content">
      <{{ title_tag }} class="card__title">{{ 'products.placeholder_title' | t }}</{{ title_tag }}>
      <div class="price"><span class="price__current">{{ 1900 | money }}</span></div>
    </div>
  </article>
{%- else -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign coming_soon = false
    if settings.coming_soon_tag != blank and product.tags contains settings.coming_soon_tag
      assign coming_soon = true
    endif

    assign secondary = nil
    if settings.card_secondary_image and product.media.size > 1 and product.media[1].media_type == 'image'
      assign secondary = product.media[1]
    endif

    assign single_variant = false
    if product.has_only_default_variant or product.variants.size == 1
      unless product.requires_selling_plan
        assign single_variant = true
      endunless
    endif

    assign card_id = 'Card-' | append: section_id | append: '-' | append: product.id
    assign swatch_option = nil
    if settings.card_show_swatches
      for option in product.options_with_values
        if option.values.first.swatch
          assign swatch_option = option
          break
        endif
      endfor
    endif
  -%}

  <article
    class="card card--{{ desktop_style }}-desktop card--{{ mobile_style }}-mobile{% if secondary %} card--has-secondary{% endif %}"
    data-reveal
    style="--reveal-index: {{ reveal_index }};"
  >
    <div class="card__media-wrap">
      <a
        href="{{ product.url }}"
        class="card__media media{% if settings.card_image_ratio == 'adapt' %} media--adapt{% endif %}"
        style="--ratio: {{ ratio }}; --fit: {{ settings.card_image_fit }};"
        tabindex="-1"
        aria-hidden="true"
      >
        {%- if product.featured_media -%}
          {% render 'image',
            image: product.featured_media.preview_image,
            sizes: image_sizes,
            widths: '240, 360, 480, 600, 720, 900, 1080',
            loading: image_loading,
            alt: product.featured_media.alt,
            class: 'card__image'
          %}
          {%- if secondary -%}
            {% render 'image',
              image: secondary.preview_image,
              sizes: image_sizes,
              widths: '240, 360, 480, 600, 720, 900, 1080',
              loading: 'lazy',
              alt: '',
              class: 'card__image card__image--secondary'
            %}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>

      {% render 'badges', product: product, class: 'card__badges' %}

      {%- if settings.card_quick_view -%}
        <a
          href="{{ product.url }}"
          class="card__quick-view icon-button"
          data-quick-view="{{ product.url }}"
          aria-label="{{ 'products.quick_view_title' | t: title: product.title | escape }}"
        >
          {% render 'icon', name: 'zoom' %}
        </a>
      {%- endif -%}

      {%- if settings.card_quick_add != 'none' and product.available and coming_soon == false -%}
        <div class="card__quick-add card__quick-add--{{ settings.card_quick_add }}">
          {%- if single_variant -%}
            {%- form 'product', product, id: card_id, class: 'card__form', data-quick-add-form: '', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
              <button
                type="submit"
                class="button button--small card__quick-add-button"
                {% if settings.card_quick_add == 'icon' %}
                  aria-label="{{ 'products.add_to_cart_title' | t: title: product.title | escape }}"
                {% endif %}
              >
                {%- if settings.card_quick_add == 'icon' -%}
                  {% render 'icon', name: 'plus' %}
                {%- else -%}
                  <span>{{ 'products.add_to_cart' | t }}</span>
                {%- endif -%}
              </button>
            {%- endform -%}
          {%- else -%}
            <a
              href="{{ product.url }}"
              class="button button--small card__quick-add-button"
              data-quick-view="{{ product.url }}"
              {% if settings.card_quick_add == 'icon' %}
                aria-label="{{ 'products.choose_options_title' | t: title: product.title | escape }}"
              {% endif %}
            >
              {%- if settings.card_quick_add == 'icon' -%}
                {% render 'icon', name: 'plus' %}
              {%- else -%}
                <span>{{ 'products.choose_options' | t }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="card__content">
      {%- if settings.card_show_vendor and product.vendor != blank -%}
        <p class="card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <{{ title_tag }} class="card__title">
        <a href="{{ product.url }}" class="card__link">{{ product.title | escape }}</a>
      </{{ title_tag }}>

      {%- if settings.card_show_rating -%}
        {% render 'rating', product: product, class: 'card__rating' %}
      {%- endif -%}

      {% render 'price', product: product, class: 'card__price' %}

      {%- if swatch_option -%}
        <div class="card__swatches">
          <span class="visually-hidden">{{ 'products.available_in' | t: count: swatch_option.values.size, option: swatch_option.name }}</span>
          <ul class="card__swatch-list" role="list" aria-hidden="true">
            {%- for value in swatch_option.values limit: 5 -%}
              <li
                class="card__swatch"
                title="{{ value | escape }}"
                {% if value.swatch.image %}
                  style="background-image: url({{ value.swatch.image | image_url: width: 48 }});"
                {% elsif value.swatch.color %}
                  style="background-color: {{ value.swatch.color }};"
                {% endif %}
              ></li>
            {%- endfor -%}
          </ul>
          {%- if swatch_option.values.size > 5 -%}
            <span class="card__swatch-more" aria-hidden="true">+{{ swatch_option.values.size | minus: 5 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if settings.card_quick_add != 'none' and product.available and coming_soon == false -%}
        <div class="card__row-action">
          {%- if single_variant -%}
            <button type="submit" form="{{ card_id }}" class="card__text-button">{{ 'products.add_to_cart' | t }}</button>
          {%- else -%}
            <a href="{{ product.url }}" class="card__text-button" data-quick-view="{{ product.url }}">
              {{- 'products.choose_options' | t -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
