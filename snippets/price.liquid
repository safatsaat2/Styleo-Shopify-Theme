{%- comment -%}
  Price with sale, compare-at, "from" range, sold out, and unit price.

  Accepts:
  - product {Product}: required
  - variant {Variant}: optional; when blank, product-level prices are used (cards)
  - show_compare {Boolean}: default true
  - show_unit {Boolean}: default true
  - class {String}

  Usage:
  {% render 'price', product: product %}
  {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
{%- endcomment -%}

{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
    assign available = variant.available
    assign varies = false
  else
    assign price = product.price
    assign compare = product.compare_at_price
    assign available = product.available
    assign varies = product.price_varies
  endif

  assign on_sale = false
  if compare > price and show_compare != false
    assign on_sale = true
  endif

  if settings.currency_code_enabled
    assign price_text = price | money_with_currency
    assign compare_text = compare | money_with_currency
  else
    assign price_text = price | money
    assign compare_text = compare | money
  endif
-%}

<div
  class="price{% if on_sale %} price--on-sale{% endif %}{% unless available %} price--sold-out{% endunless %} {{ class }}"
  data-price
>
  <span class="visually-hidden">
    {%- if on_sale %}{{ 'products.price.sale_price' | t }}{% else %}{{ 'products.price.regular_price' | t }}{% endif -%}
  </span>
  <span class="price__current">
    {%- if varies -%}
      {{ 'products.price.from' | t: price: price_text }}
    {%- else -%}
      {{ price_text }}
    {%- endif -%}
  </span>

  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_text }}</s>
  {%- endif -%}

  {%- if show_unit != false and target.unit_price_measurement -%}
    <span class="price__unit">
      <span class="visually-hidden">{{ 'products.price.unit_price' | t }}</span>
      {{- target.unit_price | money -}}
      <span aria-hidden="true">/</span>
      <span class="visually-hidden">{{ 'products.price.per' | t }}</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{- target.unit_price_measurement.reference_unit -}}
    </span>
  {%- endif -%}
</div>
