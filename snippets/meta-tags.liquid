{%- comment -%}
  Title, description, canonical, robots, Open Graph, and Twitter card tags.
  Shopify adds hreflang alternates for published languages and markets
  through content_for_header, so they aren't repeated here.
{%- endcomment -%}

{%- liquid
  assign tags_joined = current_tags | join: ', '
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase

  assign noindex = false
  if request.page_type == 'search' or current_tags
    assign noindex = true
  endif
  if request.page_type == 'collection'
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
        assign noindex = true
        break
      endif
    endfor
  endif

  assign twitter_handle = settings.social_twitter_link | split: '.com/' | last | split: '/' | first | split: '?' | first
-%}

<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: tags_joined }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page_number' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{%- if page_description != blank %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image %}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- if page_image.alt != blank %}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif %}
{%- endif %}

{%- if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

{%- if request.page_type == 'article' and article.published_at %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
{%- if settings.social_twitter_link != blank and twitter_handle != blank %}
  <meta name="twitter:site" content="@{{ twitter_handle | remove: '@' | escape }}">
{%- endif %}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
