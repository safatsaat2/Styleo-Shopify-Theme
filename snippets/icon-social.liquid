{%- comment -%}
  Simplified social platform marks on a 24px grid. Decorative; the link
  carries the accessible name.

  Accepts:
  - name {String}: instagram, facebook, tiktok, pinterest, youtube, twitter,
    threads, snapchat, linkedin, tumblr, vimeo
{%- endcomment -%}

{%- case name -%}
  {%- when 'instagram' -%}
    <svg class="icon icon--social" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.25" cy="6.75" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--social" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"/></svg>
  {%- when 'tiktok' -%}
