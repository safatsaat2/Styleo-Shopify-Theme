{%- comment -%}
  One cart line for the cart drawer and the cart page.

  Accepts:
  - item {LineItem}
  - index {Number}: 1-based line number (forloop.index)
  - section_id {String}: owning section id, used for unique input ids
  - image_width {Number}: rendered image width in px, default 96
{%- endcomment -%}

{%- liquid
  assign rule = item.variant.quantity_rule
  assign increment = rule.increment | default: 1
  assign max_quantity = rule.max
  assign input_id = 'CartQuantity-' | append: section_id | append: '-' | append: index
  assign media_width = image_width | default: 96
  assign media_sizes = media_width | append: 'px'
  assign price_each = item.final_price | money
  if settings.currency_code_enabled
    assign line_total = item.final_line_price | money_with_currency
  else
    assign line_total = item.final_line_price | money
  endif
-%}

<li class="cart-item" data-line="{{ index }}" data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-item__media media" style="--ratio: 4 / 5;" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 240
        | image_tag:
          widths: '120, 180, 240',
          sizes: media_sizes,
          loading: 'lazy',
          alt: item.image.alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <div class="cart-item__top">
      <div class="cart-item__info">
        {%- if settings.cart_show_vendor and item.vendor != blank -%}
          <p class="cart-item__vendor">{{ item.vendor }}</p>
        {%- endif -%}
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

        {%- unless item.product.has_only_default_variant -%}
          <dl class="cart-item__meta">
            {%- for option in item.options_with_values -%}
              <div>
                <dt>{{ option.name }}:</dt>
                <dd>{{ option.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endunless -%}

        {%- assign visible_properties = false -%}
        {%- for property in item.properties -%}
          {%- assign first_character = property.first | slice: 0 -%}
          {%- if property.last != blank and first_character != '_' -%}
            {%- assign visible_properties = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if visible_properties -%}
          <dl class="cart-item__meta">
            {%- for property in item.properties -%}
              {%- assign first_character = property.first | slice: 0 -%}
              {%- if property.last != blank and first_character != '_' -%}
                <div>
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a href="{{ property.last }}" class="link" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        <div class="cart-item__unit">
          {%- if item.original_price != item.final_price -%}
            <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
            <s>{{ item.original_price | money }}</s>
            <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
          {%- endif -%}
          <span>{{ 'cart.price_each' | t: price: price_each }}</span>
          {%- if item.unit_price_measurement -%}
            <span class="cart-item__unit-price">
              ({{- item.unit_price | money -}}
              <span aria-hidden="true">/</span>
              <span class="visually-hidden">{{ 'products.price.per' | t }}</span>
              {%- if item.unit_price_measurement.reference_value != 1 -%}
                {{- item.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{- item.unit_price_measurement.reference_unit -}})
            </span>
          {%- endif -%}
        </div>

        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="cart-item__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
            {%- for allocation in item.line_level_discount_allocations -%}
              <li>
                {% render 'icon', name: 'tag' %}
                {{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="cart-item__remove"
        data-cart-remove
        aria-label="{{ 'cart.remove_item' | t: title: item.title | escape }}"
      >
        {{- 'cart.remove' | t -}}
      </button>
    </div>

    <div class="cart-item__bottom">
      <div class="quantity quantity--small">
        <button
          type="button"
          class="quantity__button"
          data-quantity-step="-{{ increment }}"
          aria-label="{{ 'cart.decrease_quantity' | t: title: item.title | escape }}"
        >
          {% render 'icon', name: 'minus' %}
        </button>
        <label class="visually-hidden" for="{{ input_id }}">{{ 'cart.quantity_for' | t: title: item.title | escape }}</label>
        <input
          id="{{ input_id }}"
          class="quantity__input"
          type="number"
          inputmode="numeric"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          step="{{ increment }}"
          {% if max_quantity %}
            max="{{ max_quantity }}"
          {% endif %}
          data-line-quantity
          data-previous="{{ item.quantity }}"
        >
        <button
          type="button"
          class="quantity__button"
          data-quantity-step="{{ increment }}"
          aria-label="{{ 'cart.increase_quantity' | t: title: item.title | escape }}"
          {% if max_quantity and item.quantity >= max_quantity %}
            disabled
          {% endif %}
        >
          {% render 'icon', name: 'plus' %}
        </button>
      </div>

      <div class="cart-item__total">
        {%- if item.original_line_price != item.final_line_price -%}
          <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
          <s class="cart-item__total-compare">{{ item.original_line_price | money }}</s>
          <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
        {%- endif -%}
        <span class="cart-item__total-price">{{ line_total }}</span>
      </div>
    </div>

    <p class="cart-item__error" role="alert" data-line-error hidden>
      {% render 'icon', name: 'error' %}
      <span></span>
    </p>
  </div>
</li>
