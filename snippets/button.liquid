{%- comment -%}
  Link styled as a button.

  Accepts:
  - label {String}: required; nothing renders when blank
  - url {String}: defaults to the all-products collection
  - style {String}: 'primary' (default), 'secondary', 'outline', 'surface'
  - arrow {Boolean}: show a trailing arrow
  - size {String}: '', 'small', 'large'
  - class {String}
{%- endcomment -%}

{%- if label != blank -%}
  {%- liquid
    assign button_class = 'button'
    case style
      when 'secondary'
        assign button_class = button_class | append: ' button--secondary'
      when 'outline'
        assign button_class = button_class | append: ' button--outline'
      when 'surface'
        assign button_class = button_class | append: ' button--surface'
    endcase
    if size != blank
      assign button_class = button_class | append: ' button--' | append: size
    endif
  -%}
  <a href="{{ url | default: routes.all_products_collection_url }}" class="{{ button_class }} {{ class }}">
    <span>{{ label | escape }}</span>
    {%- if arrow -%}
      {% render 'icon', name: 'arrow-right' %}
    {%- endif -%}
  </a>
{%- endif -%}
