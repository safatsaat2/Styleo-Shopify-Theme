{%- comment -%}
  Country/region and language selectors. Each select submits the form on
  change; without JavaScript a submit button is shown.
  Renders nothing unless the store has more than one country or language.

  Accepts:
  - id {String}: unique id prefix (required when rendered more than once on a page)
  - show_country {Boolean}
  - show_language {Boolean}
  - compact {Boolean}: hide visible labels (header use)
  - class {String}
{%- endcomment -%}

{%- liquid
  assign form_id = id | default: 'Localization'
  assign render_country = false
  assign render_language = false
  if show_country and localization.available_countries.size > 1
    assign render_country = true
  endif
  if show_language and localization.available_languages.size > 1
    assign render_language = true
  endif
-%}

{%- if render_country or render_language -%}
  <lc-localization class="localization{% if compact %} localization--compact{% endif %} {{ class }}">
    {%- form 'localization', id: form_id, class: 'localization__form' -%}
      {%- if render_country -%}
        <div class="localization__field">
          <label class="localization__label{% if compact %} visually-hidden{% endif %}" for="{{ form_id }}-country">
            {{- 'localization.country_label' | t -}}
          </label>
          <div class="select-wrapper">
            <select id="{{ form_id }}-country" class="select localization__select" name="country_code">
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {%- if compact and country.iso_code == localization.country.iso_code -%}
                    {{ country.iso_code }} | {{ country.currency.iso_code }} {{ country.currency.symbol }}
                  {%- else -%}
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  {%- endif -%}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down' %}
          </div>
        </div>
      {%- endif -%}

      {%- if render_language -%}
        <div class="localization__field">
          <label class="localization__label{% if compact %} visually-hidden{% endif %}" for="{{ form_id }}-language">
            {{- 'localization.language_label' | t -}}
          </label>
          <div class="select-wrapper">
            <select id="{{ form_id }}-language" class="select localization__select" name="language_code">
              {%- for language in localization.available_languages -%}
                <option
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{- language.endonym_name | capitalize -}}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down' %}
          </div>
        </div>
      {%- endif -%}

      <button type="submit" class="button button--small no-js-only">{{ 'localization.update' | t }}</button>
    {%- endform -%}
  </lc-localization>
{%- endif -%}
