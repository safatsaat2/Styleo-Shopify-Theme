{
  "sections": {
    "slideshow": {
      "type": "slideshow",
      "blocks": {
        "s1": {
          "type": "slide",
          "settings": {
            "subheading": "New season",
            "heading": "Quiet tailoring, made to move",
            "text": "<p>Introduce your latest collection with a short line.</p>",
            "button_label": "Shop new arrivals",
            "button_style": "surface",
            "horizontal": "start",
            "vertical": "bottom",
            "color_scheme": "noir"
          }
        },
        "s2": {
          "type": "slide",
          "settings": {
            "subheading": "Essentials",
            "heading": "Pieces for every day",
            "text": "<p>Point customers to your core range.</p>",
            "button_label": "Shop essentials",
            "button_style": "surface",
            "horizontal": "start",
            "vertical": "bottom",
            "color_scheme": "noir"
          }
        }
      },
      "block_order": [
        "s1",
        "s2"
      ],
      "settings": {
        "height": "large",
        "full_width": true,
        "overlay_opacity": 25,
        "autoplay": true,
        "autoplay_speed": 6,
        "show_arrows": true,
        "accessibility_label": "Featured looks",
        "color_scheme": "noir",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "columns": {
      "type": "multicolumn",
      "blocks": {
        "a": {
          "type": "column",
          "settings": {
            "icon": "truck",
            "heading": "Free shipping",
            "text": "<p>Explain when orders ship free.</p>"
          }
        },
        "b": {
          "type": "column",
          "settings": {
            "icon": "return",
            "heading": "Easy returns",
            "text": "<p>Summarize your return policy.</p>"
          }
        },
        "c": {
          "type": "column",
          "settings": {
            "icon": "shield",
            "heading": "Secure checkout",
            "text": "<p>Reassure customers about payment.</p>"
          }
        }
      },
      "block_order": [
        "a",
        "b",
        "c"
      ],
      "settings": {
        "heading": "",
        "alignment": "center",
        "columns": 3,
        "mobile_columns": "1",
        "card_style": "plain",
        "color_scheme": "paper",
        "padding_top": 48,
        "padding_bottom": 48
      }
